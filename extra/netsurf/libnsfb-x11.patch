+/**
+ * Resize an initialised surface to match a new window size.
+ *
+ * Replaces the local image buffer and the server side backing pixmap. The
+ * pixel format cannot be changed.
+ */
+static int
+x_resize_surface(nsfb_t *nsfb, int width, int height,
+                 enum nsfb_format_e format)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    xcb_image_t *old_image = xstate->image;
+    xcb_shm_segment_info_t old_shm = xstate->shminfo;
+    xcb_image_t *image = NULL;
+
+    if (format != nsfb->format)
+        return -1; /* cannot change pixel format of a live window */
+
+    if ((width == nsfb->width) && (height == nsfb->height))
+        return 0;
+
+    if (old_shm.shmseg != 0)
+        image = create_shm_image(xstate, width, height, nsfb->bpp);
+
+    if (image == NULL) {
+        xstate->shminfo.shmseg = 0;
+        image = create_image(xstate->connection, width, height, nsfb->bpp);
+    }
+
+    if (image == NULL) {
+        xstate->shminfo = old_shm;
+        return -1;
+    }
+
+    xstate->image = image;
+    nsfb->width = width;
+    nsfb->height = height;
+    nsfb->ptr = image->data;
+    nsfb->linelen = image->stride;
+
+    /* the saved cursor background belongs to the old buffer */
+    if (nsfb->cursor != NULL)
+        nsfb->cursor->plotted = false;
+
+    nsfb->plotter_fns->set_clip(nsfb, NULL);
+
+    /* recreate the backing pixmap at the new size */
+    xcb_free_pixmap(xstate->connection, xstate->pmap);
+    xcb_create_pixmap(xstate->connection, 24, xstate->pmap, xstate->window,
+                      width, height);
+
+    /* release the old buffer */
+    if (old_shm.shmseg != 0) {
+        xcb_shm_detach(xstate->connection, old_shm.shmseg);
+        shmdt(old_shm.shmaddr);
+        old_image->base = NULL; /* shared memory is not heap allocated */
+    }
+    xcb_image_destroy(old_image);
+
+    return 0;
+}
