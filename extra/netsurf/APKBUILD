# Maintainer: Damir Holovati

pkgname=netsurf
pkgver=3.11
pkgrel=2

pkgdesc="Ultra-lightweight web browser"
url="https://www.netsurf-browser.org/"
arch="all"
license="GPL-2.0-only"

depends="libxcb xcb-util xcb-util-image xcb-util-keysyms xcb-util-wm libpng libjpeg freetype font-dejavu openssl curl"
makedepends="$depends libxcb xcb-proto pkgconf"

# subpackages="$pkgname-doc"

# libnsfb-x11.patch: skip MIT-SHM when the X server lacks it, do not make the
# window fixed size (tiling WMs such as dwm float those) and follow window
# resizes.
source="$pkgname-$pkgver.tar.gz::https://download.netsurf-browser.org/netsurf/releases/source-full/netsurf-all-$pkgver.tar.gz
	libnsfb-x11.patch
	"

sha512sums="
f931687e08976ca336762587cc1ac75e45518be62b19d1d31aac3063b92b9666f8a022ff3a183e80c89404ba8ff33458b26521130e96943043085a42291ee283  netsurf-3.11.tar.gz
e4680c5a4c9b9e6004756031fc3a220fc34d1e0992e6505d7f0e69e4470047165c6983c4009ec3763570ce5812bf7726831efb4d9008736027d0af61c8ec3d68  libnsfb-x11.patch
"

builddir="$srcdir/$pkgname-all-$pkgver"

prepare() {
    default_prepare
    cat >> "$builddir/netsurf/Makefile.config" <<-EOF
	NETSURF_TARGET := framebuffer
	NETSURF_FB_FRONTEND := x
	NETSURF_FB_FONTLIB := freetype
	NETSURF_FB_FONTPATH := /usr/share/fonts/dejavu
	NETSURF_FB_FONT_CURSIVE := DejaVuSerif-Italic.ttf
	NETSURF_FB_FONT_FANTASY := DejaVuSans-Bold.ttf
EOF
}

build() {
    # libnsfb autodetects the XCB surface via pkg-config; fail early if missing
    pkg-config --exists xcb xcb-icccm xcb-image xcb-keysyms xcb-atom xcb-aux ||
	    { echo "missing xcb-util pkg-config modules" >&2; return 1; }

    make TARGET=framebuffer \
	 PREFIX=/usr \
	 LIBDIR=lib \
	 INCLUDEDIR=include
}

package() {
        make TARGET=framebuffer \
	 PREFIX=/usr \
	 LIBDIR=lib \
	 INCLUDEDIR=include \
	 DESTDIR="$pkgdir" \
	 install

	# JavaScript (bundled duktape) is compiled in but disabled by default.
	# Per-user ~/.netsurf/Choices is searched first and overrides this.
	mkdir -p "$pkgdir"/usr/share/netsurf
	echo "enable_javascript:1" > "$pkgdir"/usr/share/netsurf/Choices
	chmod 644 "$pkgdir"/usr/share/netsurf/Choices
}
