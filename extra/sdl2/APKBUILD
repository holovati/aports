# Maintainer Damir Holovati
pkgname=sdl2
pkgver=2.32.8
pkgrel=0
pkgdesc="Game development library"
url="https://www.libsdl.org"
arch="all"
license="Zlib"

# libxi libxkbcommon 
makedepends="make autoconf automake libx11 libxcursor libxext libxrandr libxrender libevdev"

source="sdl-$pkgver.tar.gz::https://github.com/libsdl-org/SDL/archive/refs/tags/release-$pkgver.tar.gz
	configure-add-emerixx.patch
	evdev-add-emerixx.patch"

builddir="$srcdir/SDL-release-$pkgver"

build() {
    
    ./configure \
	--build=$CBUILD \
	--host=$CHOST \
	--prefix=/usr \
	--disable-static \
	--disable-joystick \
	--disable-haptic \
	--disable-hidapi \
	--disable-sensor \
	--disable-power \
	--disable-cpuinfo \
	--disable-video-vulkan \
	--disable-video-opengles

    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}
