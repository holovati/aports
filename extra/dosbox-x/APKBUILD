# Maintainer Damir Holovati
pkgname=dosbox-x
pkgver=2026.05.02
pkgrel=0
pkgdesc="DOS emulator"
url="https://dosbox-x.com"
arch="all"
license="GPL-2.0"

subpackages="$pkgname-doc"

depends="libpng sdl2 ncurses zlib libx11"

makedepends="make autoconf automake $depends"

source="https://github.com/joncampbell123/dosbox-x/archive/refs/tags/$pkgname-v$pkgver.tar.gz
	configure-add-emerixx.patch"

builddir="$srcdir/$pkgname-$pkgname-v$pkgver"

prepare() {
    default_prepare
    emerixx_prepare
    ./autogen.sh
}

build() {
    
    ./configure \
	--build=$CBUILD \
	--host=$CHOST \
	--prefix=/usr \
	--enable-sdl2 \
	--disable-opengl \
	--disable-gamelink \
	--disable-sdlnet \
	--disable-alsa-midi

    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
}
