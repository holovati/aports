b23d57e9eb7ba0f14fbd7eb577e6bfe1d32b2f6176e78b19e94afaf0c09bbd30ca261c073815025235a6d522da5e4ed463f1d97c61e880c69b2d7d831bfbf32e  surf-no-gcr.patch
"
