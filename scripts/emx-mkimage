#!/usr/bin/env python3
"""Build a bootable emerixx disk image from the aports checkout this script lives in.

    emx-mkimage base    -o base.img
    emx-mkimage builder -o builder.img --ip 192.168.1.90 --gw 192.168.1.1 --ssh-key ~/.ssh/id.pub

What it does:
  1. read every APKBUILD in main/ and extra/
  2. work out which packages the profile needs and build the missing ones with abuild,
     dependencies first
  3. install the profile into a directory with apk
  4. write a GPT disk (ESP + root), compress it

Run it as root on emerixx. --dry-run works anywhere and only prints the plan.
Profiles live in profiles.toml next to this file.
"""

from __future__ import annotations

import argparse
import dataclasses
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
PROFILES_FILE = SCRIPT_DIR / "profiles.toml"
ARCH = os.uname().machine
REPO_NAMES = ("main", "extra")

# Disk layout the initramfs expects: sda1 = ESP, sda2 = root.
ESP_START = 2048  # sectors, 1 MiB
TAIL_SECTORS = 2048  # room for the backup GPT

REQUIRED_TOOLS = ("apk", "parted", "mkfs.vfat", "mcopy", "mke2fs")


class Error(Exception):
    pass


# ---------------------------------------------------------------------------
# aports
# ---------------------------------------------------------------------------

_VERSION_OP = re.compile(r"[<>=~].*$")


def dep_names(items: list[str]) -> list[str]:
    """Package names of a depends-style list: no conflicts, no so:/cmd:/pc: names, no versions."""
    names = []
    for item in items:
        if item.startswith("!") or ":" in item:
            continue
        names.append(_VERSION_OP.sub("", item))
    return names


@dataclasses.dataclass
class Aport:
    key: str  # directory name
    repo: str  # main, extra
    path: Path
    pkgname: str
    pkgver: str
    pkgrel: str
    arch: list[str]
    subpackages: list[str]
    provides: list[str]
    depends: list[str]
    makedepends: list[str]

    @property
    def version(self) -> str:
        return f"{self.pkgname}-{self.pkgver}-r{self.pkgrel}"

    @property
    def buildable(self) -> bool:
        if f"!{ARCH}" in self.arch:
            return False
        return any(a in ("all", "noarch", ARCH) for a in self.arch)

    def is_built(self, repodest: Path) -> bool:
        return any((repodest / self.repo / d / f"{self.version}.apk").exists() for d in (ARCH, "noarch"))


@dataclasses.dataclass
class Step:
    """One abuild run. A package of a dependency cycle takes two: a bootstrap pass without the
    dependencies that close the cycle and a rebuild once everything it needs exists."""

    aport: Aport  # for a bootstrap step the variant read with APORTS_BOOTSTRAP=1
    stage: str = ""  # "", "bootstrap" or "rebuild"
    dropped: list[str] = dataclasses.field(default_factory=list)  # dependencies the bootstrap pass leaves out

    def marker_path(self, repodest: Path) -> Path:
        """Exists between the bootstrap pass and the rebuild, so an aborted run is continued."""
        return repodest / self.aport.repo / f".bootstrap-{self.aport.version}"

    def needed(self, repodest: Path, force: bool) -> bool:
        if force or not self.aport.is_built(repodest):
            return True
        # the bootstrap pass is done but the rebuild is not (an earlier run stopped in between)
        return self.stage == "rebuild" and self.marker_path(repodest).exists()

    @property
    def label(self) -> str:
        if self.stage == "bootstrap":
            return f"{self.aport.version} (pass 1 of 2, without {' '.join(self.dropped)})"
        if self.stage == "rebuild":
            return f"{self.aport.version} (pass 2 of 2, complete)"
        return self.aport.version


_FIELDS = (
    "pkgname",
    "pkgver",
    "pkgrel",
    "arch",
    "subpackages",
    "provides",
    "depends",
    "makedepends",
    "makedepends_build",
    "makedepends_host",
)


def read_apkbuild(path: Path, bootstrap: bool = False) -> Aport | None:
    """Source the APKBUILD in a shell, the same way abuild does, and read the variables.

    bootstrap=True sets APORTS_BOOTSTRAP=1, an APKBUILD can use it to leave out dependencies
    (and the features that need them) to break a dependency cycle.
    """
    script = "set -f; { . ./APKBUILD; } >/dev/null 2>&1 </dev/null; " + "; ".join(f"echo ${f}" for f in _FIELDS)
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "CARCH": ARCH,
        "CBUILD": ARCH,
        "CHOST": ARCH,
        "srcdir": "/nonexistent",
        "pkgdir": "/nonexistent",
        "startdir": str(path.parent),
    }
    if bootstrap:
        env["APORTS_BOOTSTRAP"] = "1"
    proc = subprocess.run(["sh", "-c", script], cwd=path.parent, env=env, capture_output=True, text=True)
    lines = proc.stdout.splitlines()
    if len(lines) != len(_FIELDS) or not lines[0]:
        return None
    v = dict(zip(_FIELDS, lines))
    # abuild 3.16 calcdeps() for a native build: `[ -z "$makedepends" ] && makedepends="$makedepends_build $makedepends_host"`,
    # so the split variables only count when makedepends is empty.
    makedepends = v["makedepends"].split() or (v["makedepends_build"].split() + v["makedepends_host"].split())
    return Aport(
        key=path.parent.name,
        repo=path.parent.parent.name,
        path=path.parent,
        pkgname=v["pkgname"].strip(),
        pkgver=v["pkgver"].strip(),
        pkgrel=v["pkgrel"].strip() or "0",
        arch=v["arch"].split(),
        subpackages=[s.split(":")[0] for s in v["subpackages"].split()],
        provides=dep_names(v["provides"].split()),
        depends=dep_names(v["depends"].split()),
        makedepends=dep_names(makedepends),
    )


class Aports:
    """All packages of an aports checkout."""

    def __init__(self, root: Path):
        self.root = root
        self.items: dict[str, Aport] = {}  # key -> Aport
        self.owner: dict[str, str] = {}  # package/subpackage/provides name -> key
        self.warnings: list[str] = []
        self._variants: dict[str, Aport | None] = {}

        for repo in REPO_NAMES:
            for apkbuild in sorted((root / repo).glob("*/APKBUILD")):
                aport = read_apkbuild(apkbuild)
                if aport is None:
                    self.warnings.append(f"cannot read {apkbuild}, skipped")
                elif aport.buildable:
                    self.items[aport.key] = aport

        if not self.items:
            raise Error(f"no APKBUILDs found in {root}")

        for aport in self.items.values():
            for name in aport.subpackages + aport.provides:
                self.owner.setdefault(name, aport.key)
        for aport in self.items.values():
            self.owner[aport.pkgname] = aport.key
            self.owner[aport.key] = aport.key

    def dep_keys(self, aport: Aport) -> list[str]:
        """Aports that provide the makedepends and depends of an aport, without itself."""
        keys = [self.owner.get(n) for n in aport.makedepends + aport.depends]
        return [k for k in dict.fromkeys(keys) if k is not None and k != aport.key]

    def bootstrap_variant(self, key: str) -> Aport | None:
        """The aport as read with APORTS_BOOTSTRAP=1, None when that changes no dependency."""
        if key not in self._variants:
            full = self.items[key]
            variant = read_apkbuild(full.path / "APKBUILD", bootstrap=True)
            if variant is not None and set(variant.makedepends + variant.depends) == set(full.makedepends + full.depends):
                variant = None
            self._variants[key] = variant
        return self._variants[key]

    def _drops_edge(self, key: str, target: str) -> bool:
        """Does the bootstrap variant of key leave out everything that pulls in the aport target?"""
        variant = self.bootstrap_variant(key)
        if variant is None:
            return False

        def pulls(a: Aport) -> bool:
            return any(self.owner.get(n) == target for n in a.makedepends + a.depends)

        return pulls(self.items[key]) and not pulls(variant)

    def _sort(self, wanted: set[str], variants: dict[str, Aport]) -> tuple[list[Aport], list[list[str]]]:
        """Depth first order of the wanted keys, dependencies first, plus the makedepends cycles.

        A cycle member list is in dependency order, the last one needs the first. Runtime depends
        cycles are harmless for building and ignored. A cycle edge is dropped from the order.
        """
        state: dict[str, int] = {}  # 1 = visiting, 2 = done
        result: list[Aport] = []
        stack: list[str] = []
        cycles: list[list[str]] = []

        def visit(key: str) -> bool:
            if state.get(key) == 2:
                return True
            if state.get(key) == 1:
                return False
            state[key] = 1
            stack.append(key)
            aport = variants.get(key, self.items[key])
            for hard, names in ((True, aport.makedepends), (False, aport.depends)):
                for name in names:
                    dep = self.owner.get(name)
                    if dep is None or dep == key:
                        continue
                    if not visit(dep) and hard:
                        cycles.append(stack[stack.index(dep) :])
            stack.pop()
            state[key] = 2
            result.append(aport)
            return True

        for key in sorted(wanted):
            visit(key)
        return result, cycles

    def order(self, wanted: set[str]) -> tuple[list[Step], list[str]]:
        """Build steps for the wanted aport keys plus everything they need, dependencies first.

        A makedepends cycle is solved in two passes when one of its packages can leave out the
        dependency that closes it: the APKBUILD checks APORTS_BOOTSTRAP and drops the dependency
        and the feature that needs it. That package is built first without it and once more,
        complete, after the packages it was missing. Cycles nobody can break are returned as text,
        an already built package of such a cycle is needed.
        """
        wanted = set(wanted)
        variants: dict[str, Aport] = {}
        while True:
            result, cycles = self._sort(wanted, variants)
            breaker = next(
                (
                    key
                    for cycle in cycles
                    for i, key in enumerate(cycle)
                    if key not in variants and self._drops_edge(key, cycle[(i + 1) % len(cycle)])
                ),
                None,
            )
            if breaker is None:
                break
            variant = self.bootstrap_variant(breaker)
            assert variant is not None
            variants[breaker] = variant
            wanted |= set(self.dep_keys(self.items[breaker]))  # the rebuild needs all of them

        steps = []
        for aport in result:
            if aport.key in variants:
                full = self.items[aport.key]
                dropped = sorted(set(full.makedepends + full.depends) - set(aport.makedepends + aport.depends))
                steps.append(Step(aport, "bootstrap", dropped))
            else:
                steps.append(Step(aport))

        position = {s.aport.key: i for i, s in enumerate(steps)}
        rebuilds: dict[int, list[Step]] = {}
        for key in variants:
            full = self.items[key]
            at = max([position[key]] + [position[k] for k in self.dep_keys(full) if k in position])
            rebuilds.setdefault(at, []).append(Step(full, "rebuild"))
        ordered: list[Step] = []
        for i, step in enumerate(steps):
            ordered.append(step)
            ordered.extend(rebuilds.get(i, []))
        return ordered, [" -> ".join(c + [c[0]]) for c in cycles]


# ---------------------------------------------------------------------------
# profiles and plan
# ---------------------------------------------------------------------------


@dataclasses.dataclass
class Profile:
    name: str
    description: str = ""
    packages: list[str] = dataclasses.field(default_factory=list)
    all_makedepends: bool = False
    ship_aports: bool = False
    serve_port: int = 0
    rebuild_script: bool = False


def profile_names(path: Path = PROFILES_FILE) -> list[str]:
    return sorted(tomllib.loads(path.read_text()))


def load_profile(name: str, path: Path = PROFILES_FILE) -> Profile:
    data = tomllib.loads(path.read_text())

    def resolve(n: str, seen: tuple[str, ...]) -> Profile:
        if n not in data:
            raise Error(f"unknown profile {n!r}, available: {', '.join(sorted(data))}")
        if n in seen:
            raise Error(f"profile {n!r} extends itself")
        entry = data[n]
        base = resolve(entry["extends"], seen + (n,)) if "extends" in entry else Profile(n)
        return Profile(
            name=n,
            description=entry.get("description", base.description),
            packages=base.packages + [p for p in entry.get("packages", []) if p not in base.packages],
            all_makedepends=entry.get("all_makedepends", base.all_makedepends),
            ship_aports=entry.get("ship_aports", base.ship_aports),
            serve_port=entry.get("serve_port", base.serve_port),
            rebuild_script=entry.get("rebuild_script", base.rebuild_script),
        )

    return resolve(name, ())


@dataclasses.dataclass
class Plan:
    install: list[str]  # package names given to apk add
    steps: list[Step]  # everything that has to exist in the repository, dependencies first
    unresolved: list[str]  # makedepends that no aport provides
    cycles: list[str]  # cycles no package can break

    @property
    def order(self) -> list[Aport]:
        """Every aport once, a package built in two passes at its first one."""
        return [s.aport for s in self.steps if s.stage != "rebuild"]


def make_plan(aports: Aports, profile: Profile, extra: list[str], build_all: bool) -> Plan:
    wanted_names = list(dict.fromkeys(profile.packages + extra))
    missing = [n for n in wanted_names if n not in aports.owner]
    if missing:
        raise Error(f"no aport provides: {', '.join(missing)}")

    install = list(wanted_names)
    unresolved: set[str] = set()
    if profile.all_makedepends:
        for aport in aports.items.values():
            for name in aport.makedepends:
                if name in aports.owner:
                    install.append(name)
                else:
                    unresolved.add(name)
    install = list(dict.fromkeys(install))

    wanted = {aports.owner[n] for n in install}
    if build_all:
        wanted |= set(aports.items)
    steps, cycles = aports.order(wanted)
    return Plan(install, steps, sorted(unresolved), cycles)


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------


def call(cmd: list, **kwargs) -> None:
    print("+ " + shlex.join(str(c) for c in cmd), flush=True)
    subprocess.run([str(c) for c in cmd], check=True, **kwargs)


def parse_size(text: str) -> int:
    m = re.fullmatch(r"(\d+)([KMGT]?)", text.upper())
    if not m:
        raise argparse.ArgumentTypeError(f"bad size {text!r}, use e.g. 4G or 512M")
    return int(m.group(1)) * {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}[m.group(2)]


def _pattern(regex: str, what: str):
    compiled = re.compile(regex)

    def check(text: str) -> str:
        if not compiled.fullmatch(text):
            raise argparse.ArgumentTypeError(f"bad {what}: {text!r}")
        return text

    return check


hostname_arg = _pattern(r"[A-Za-z0-9.-]+", "hostname")
iface_arg = _pattern(r"[A-Za-z0-9._-]+", "interface name")
addr_arg = _pattern(r"[0-9A-Fa-f:.]+", "address")
hash_arg = _pattern(r"[A-Za-z0-9./$_-]+", "password hash")
package_arg = _pattern(r"[A-Za-z0-9._+-]+", "package name")


def readable_file(text: str) -> Path:
    path = Path(text).expanduser()
    if not path.is_file():
        raise argparse.ArgumentTypeError(f"cannot read {text}")
    return path


# ---------------------------------------------------------------------------
# building
# ---------------------------------------------------------------------------


def abuild_keys() -> list[Path]:
    """Make sure a signing key exists and its public half is trusted by apk."""
    home = Path(os.environ.get("HOME", "/root"))
    if not list((home / ".abuild").glob("*.rsa")):
        call(["abuild-keygen", "-a", "-n"])
    keys = sorted((home / ".abuild").glob("*.rsa.pub"))
    Path("/etc/apk/keys").mkdir(parents=True, exist_ok=True)
    for key in keys:
        shutil.copy(key, "/etc/apk/keys/")
    return keys


def build_deps(aports: Aports, aport: Aport) -> tuple[list[str], list[str]]:
    """Makedepends of an aport split in (installable, no aport provides them).

    abuild would install these itself, but it needs abuild-apk, adds build-base and fails on names
    like zlib-dev that emerixx does not have, so emx-mkimage does it and runs abuild with -d.
    """
    found: list[str] = []
    unknown: list[str] = []
    for name in aport.makedepends:
        if name not in aports.owner:
            unknown.append(name)
        elif aports.owner[name] != aport.key and name not in found:
            found.append(name)
    return found, unknown


def force_remove(path: Path) -> None:
    """rm -rf that retries and only warns when the tree cannot be removed completely."""
    for _ in range(3):
        if not os.path.lexists(path):
            return
        shutil.rmtree(path, ignore_errors=True)
        if os.path.lexists(path):
            subprocess.run(["rm", "-rf", str(path)], check=False, stderr=subprocess.DEVNULL)
    if os.path.lexists(path):
        print(f"warning: could not remove {path}, ignored", file=sys.stderr)


def clean_build_dirs(aport: Aport) -> None:
    for d in ("src", "pkg", "tmp"):
        force_remove(aport.path / d)


def apk_installed(name: str) -> bool:
    return subprocess.run(["apk", "info", "-e", name], capture_output=True).returncode == 0


def installed_versions() -> dict[str, str]:
    """Installed packages as {name: version-rN}, empty when apk list cannot be read."""
    run = subprocess.run(["apk", "list", "--installed"], capture_output=True, text=True)
    versions: dict[str, str] = {}
    for line in run.stdout.splitlines():
        m = re.match(r"(\S+?)-(\d[^-\s]*-r\d+)(\s|$)", line)
        if m:
            versions[m.group(1)] = m.group(2)
    return versions


def stale_deps(aports: Aports, deps: list[str]) -> list[str]:
    """Build dependencies that are not installed or installed in another version than the aport has.

    A rebuilt library must replace the old one, otherwise packages keep being linked against it.
    """
    have = installed_versions()
    stale = []
    for d in deps:
        owner = aports.items[aports.owner[d]]
        wanted = f"{owner.pkgver}-r{owner.pkgrel}"
        if not apk_installed(d) or have.get(d, wanted) != wanted:
            stale.append(d)
    return stale


def build_packages(
    aports: Aports,
    todo: list[Step],
    repodest: Path,
    abuild_flags: list[str],
    register_repos: bool = False,
    keep_deps: bool = False,
) -> None:
    abuild_keys()
    for i, step in enumerate(todo, 1):
        aport = step.aport
        env = {**os.environ, "REPODEST": str(repodest)}
        env.pop("APORTS_BOOTSTRAP", None)
        if step.stage == "bootstrap":
            env["APORTS_BOOTSTRAP"] = "1"
        print(f"== [{i}/{len(todo)}] {step.label}", flush=True)
        deps, unknown = build_deps(aports, aport)
        if unknown:
            print(f"warning: {aport.key}: no aport provides {' '.join(unknown)}, not installed", file=sys.stderr)
        virtual = f".emx-build-{aport.key}"
        if apk_installed(virtual):  # left over from an aborted run
            subprocess.run(["apk", "del", "--repositories-file", "/dev/null", virtual], check=False)
        missing = stale_deps(aports, deps)
        if missing:
            # Only the repositories built here: a dead entry in /etc/apk/repositories (the host that
            # served the image) makes apk fail even when nothing has to be downloaded.
            repo_args = ["--repositories-file", "/dev/null"]
            repo_args += [a for r in local_repos(repodest) for a in ("--repository", str(r))]
            try:
                call(["apk", "add", "--verbose", "--upgrade", "--virtual", virtual, *repo_args, *missing])
            except subprocess.CalledProcessError:
                # apk exits non-zero on every transaction while the database records a broken
                # package ("1 error; N packages"), so only a dependency that is still missing is fatal.
                still = stale_deps(aports, deps)
                if still:
                    raise Error(f"cannot install the build dependencies of {aport.key}: {' '.join(still)}")
                print(f"warning: apk reported errors installing the build dependencies of {aport.key}, "
                      "they are installed, continuing", file=sys.stderr)
        clean_build_dirs(aport)
        try:
            # -F: abuild refuses to run as root, -d: dependencies are installed above,
            # -K: abuild does not clean up, its rm -rf aborts the build when a directory cannot be
            # removed, emx-mkimage cleans up below and ignores failures. -f: the rebuild of a package
            # built in two passes finds the apk of the first pass in the repository.
            cmd = ["abuild", "-F", "-d", "-K", *(["-f"] if step.stage == "rebuild" else []), *abuild_flags]
            call(cmd, cwd=aport.path, env=env)
        except subprocess.CalledProcessError:
            raise Error(f"build of {aport.key} failed, fix it and run again, finished packages are kept")
        finally:
            clean_build_dirs(aport)
            if missing and not keep_deps:
                subprocess.run(["apk", "del", "--repositories-file", "/dev/null", virtual], check=False)
        if step.stage == "bootstrap":
            step.marker_path(repodest).touch()
        elif step.stage == "rebuild":
            step.marker_path(repodest).unlink(missing_ok=True)
        if register_repos:
            register_local_repo(repodest / aport.repo)


def quarantine_untrusted(repodest: Path) -> list[Path]:
    """Move packages that apk does not trust (signed with a key that is gone) out of the repository.

    abuild re-indexes every .apk of the repository and stops at the first untrusted one. The
    packages are moved to <repo>/untrusted and are built again.
    """
    moved: list[Path] = []
    for repo in REPO_NAMES:
        for d in (ARCH, "noarch"):
            for apk in sorted((repodest / repo / d).glob("*.apk")):
                if subprocess.run(["apk", "verify", str(apk)], capture_output=True).returncode == 0:
                    continue
                dest = repodest / repo / "untrusted"
                dest.mkdir(exist_ok=True)
                shutil.move(str(apk), dest / apk.name)
                moved.append(apk)
    return moved


def register_local_repo(repo: Path) -> None:
    """Add a repository abuild has just filled to /etc/apk/repositories, so later builds can install from it."""
    if not (repo / ARCH / "APKINDEX.tar.gz").exists():
        return
    repos_file = Path("/etc/apk/repositories")
    known = repos_file.read_text().split() if repos_file.exists() else []
    if str(repo) not in known:
        with open(repos_file, "a") as f:
            f.write(f"{repo}\n")


# ---------------------------------------------------------------------------
# image
# ---------------------------------------------------------------------------


def local_repos(repodest: Path) -> list[Path]:
    return [repodest / r for r in REPO_NAMES if (repodest / r / ARCH / "APKINDEX.tar.gz").exists()]


def install_root(root: Path, args, plan: Plan, public_keys: list[Path]) -> None:
    keys_dir = root / "etc/apk/keys"
    keys_dir.mkdir(parents=True)
    for key in [*Path("/etc/apk/keys").glob("*.pub"), *public_keys]:
        shutil.copy(key, keys_dir)

    repos = local_repos(args.repodest)
    if not repos:
        raise Error(f"no repository in {args.repodest}, nothing to install from")
    (root / "etc/apk/repositories").write_text("".join(f"{r}\n" for r in repos))

    cmd = ["apk", "--root", root, "--initdb"]
    if args.untrusted:
        cmd.append("--allow-untrusted")
    # apk runs install scripts chrooted into the new root. #!/bin/sh and the dynamic loader in
    # /lib only resolve once /bin and /lib point into /usr, which nothing has created yet in an
    # empty root.
    seed_usr_merge(root)
    # apk orders packages by dependencies only. emx-baselayout is its own transaction so that its
    # post-install script has created /dev/null and the other device nodes (and /etc/passwd, ...)
    # before the install script of any other package runs.
    if "emx-baselayout" in plan.install or "emx-base" in plan.install:
        call([*cmd, "add", "emx-baselayout"])
    call([*cmd, "add", *plan.install])

    for need in ("boot/efi/kernel.elf", "boot/efi/EFI/BOOT/BOOTX64.EFI"):
        if not (root / need).is_file():
            raise Error(f"{need} is missing from the root, kernel and emerixx-loader must be installed")


def seed_usr_merge(root: Path) -> None:
    """Create the /usr layout and the /bin, /sbin, /lib symlinks before packages are installed."""
    for name in ("bin", "sbin", "lib"):
        (root / "usr" / name).mkdir(parents=True, exist_ok=True)
        if not (root / name).exists() and not (root / name).is_symlink():
            (root / name).symlink_to(f"usr/{name}")


def merge_usr(root: Path) -> None:
    """/bin, /sbin and /lib are symlinks into /usr on emerixx."""
    for name in ("bin", "sbin", "lib"):
        path = root / name
        if path.is_dir() and not path.is_symlink():
            (root / "usr" / name).mkdir(parents=True, exist_ok=True)
            shutil.copytree(path, root / "usr" / name, symlinks=True, dirs_exist_ok=True)
            shutil.rmtree(path)
        if not (path.exists() or path.is_symlink()):
            path.symlink_to(f"usr/{name}")


def configure_root(root: Path, args, profile: Profile) -> None:
    (root / "etc/hostname").write_text(args.hostname + "\n")
    hosts = root / "etc/hosts"
    if hosts.exists():
        hosts.write_text(re.sub(r"(?m)^127\.0\.1\.1.*$", f"127.0.1.1   {args.hostname}", hosts.read_text()))

    if args.dns:
        (root / "etc/resolv.conf").write_text("".join(f"nameserver {n}\n" for n in args.dns))

    if args.ip:
        (root / "etc/emx").mkdir(parents=True, exist_ok=True)
        (root / "etc/emx/network.conf").write_text(
            f"IFACE={args.iface}\nADDRESS={args.ip}\nNETMASK={args.netmask}\nGATEWAY={args.gw or ''}\n"
        )

    shadow = root / "etc/shadow"
    if args.root_password_hash and shadow.exists():
        text = re.sub(r"(?m)^root:[^:]*:", lambda _: f"root:{args.root_password_hash}:", shadow.read_text())
        shadow.write_text(text)

    if args.ssh_key:
        ssh = root / "root/.ssh"
        ssh.mkdir(parents=True, exist_ok=True)
        ssh.chmod(0o700)
        (ssh / "authorized_keys").write_text(args.ssh_key.read_text())
        (ssh / "authorized_keys").chmod(0o600)

    repos = list(args.image_repo)
    if not repos and not profile.rebuild_script:
        print("warning: the image has no apk repositories, point /etc/apk/repositories at one", file=sys.stderr)
    (root / "etc/apk/repositories").write_text("".join(f"{r}\n" for r in repos))

    if profile.serve_port:
        rc = root / "etc/rc.d/090-repohost.sh"
        rc.parent.mkdir(parents=True, exist_ok=True)
        rc.write_text(
            "#!/bin/sh\n"
            f'run "Package host on port {profile.serve_port}" sh -c '
            f"'mkdir -p /root/packages && python3 -m http.server {profile.serve_port} --directory /root/packages "
            ">>/var/log/repohost.log 2>&1 &'\n"
        )
        rc.chmod(0o755)

    if profile.rebuild_script:
        # The image has the toolchain and the aports tree but no .apk files. Nothing builds by
        # itself: the user runs this after logging in, in the foreground, with all output on the
        # terminal. It only builds what is missing, so it can be run again after a failure.
        # Each finished repository is added to /etc/apk/repositories by --register-repos.
        script = root / "usr/local/bin/emx-rebuild-all"
        script.parent.mkdir(parents=True, exist_ok=True)
        script.write_text(
            "#!/bin/sh\n"
            "# Build every package in /root/aports. Extra arguments go to emx-mkimage, for example\n"
            "#   emx-rebuild-all --force      build everything again\n"
            "#   emx-rebuild-all --dry-run    show what is left to build\n"
            "#   emx-rebuild-all --pull       git pull --ff-only first\n"
            "# To keep a log: emx-rebuild-all 2>&1 | tee /var/log/rebuild-all.log\n"
            "if [ ! -d /root/aports/scripts ]; then\n"
            "    echo 'emx-rebuild-all: /root/aports is missing' >&2\n"
            "    exit 1\n"
            "fi\n"
            "cd /root/aports/scripts || exit 1\n"
            "HOME=/root exec python3 ./emx-mkimage builder --build-all --no-image --register-repos --keep-deps \"$@\"\n"
        )
        script.chmod(0o755)


def ship_content(root: Path, args, profile: Profile) -> None:
    """Copy the aports checkout into the image. Packages are never copied, the image builds them."""
    if profile.ship_aports:
        print("== Copying aports to /root/aports", flush=True)
        shutil.copytree(args.aports, root / "root/aports", symlinks=True, dirs_exist_ok=True)
    (root / "root/packages").mkdir(parents=True, exist_ok=True)


def write_disk(root: Path, out: Path, esp_mb: int, root_bytes: int) -> None:
    root_bytes -= root_bytes % 4096
    esp_sectors = esp_mb * 2048
    root_start = ESP_START + esp_sectors
    root_sectors = root_bytes // 512
    total = root_start + root_sectors + TAIL_SECTORS

    out.unlink(missing_ok=True)
    with open(out, "wb") as f:
        f.truncate(total * 512)

    call(
        [
            "parted", "-s", out,
            "mklabel", "gpt",
            "mkpart", "ESP", "fat32", f"{ESP_START}s", f"{root_start - 1}s",
            "set", "1", "esp", "on",
            "mkpart", "root", "ext2", f"{root_start}s", f"{root_start + root_sectors - 1}s",
        ]
    )  # fmt: skip

    esp = root / "boot/efi"
    # The ESP is built as a file of its own and copied into the disk. mkfs.fat with --offset
    # looks at the whole disk file instead of the partition: it warns about a block count
    # mismatch and sizes the clusters from the disk, so a 32G image gets 16K clusters and the 64M
    # ESP ends up with 4092 of them. Firmware tells FAT12, FAT16 and FAT32 apart by the cluster
    # count (FAT32 needs 65525), so it would not mount that. 512 byte clusters give about 129000.
    esp_img = Path(f"{out}.esp")
    esp_img.unlink(missing_ok=True)
    with open(esp_img, "wb") as f:
        f.truncate(esp_mb * 1024 * 1024)
    try:
        call(["mkfs.vfat", "-F", "32", "-S", "512", "-s", "1", "-n", "EMXESP", esp_img])
        call(["mcopy", "-i", esp_img, "-s", "-o", *sorted(esp.iterdir()), "::/"])
        with open(esp_img, "rb") as src, open(out, "r+b") as dst:
            dst.seek(ESP_START * 512)
            shutil.copyfileobj(src, dst, 1 << 20)
    finally:
        esp_img.unlink(missing_ok=True)
    for entry in list(esp.iterdir()):  # the ESP is a mount point inside the root
        shutil.rmtree(entry) if entry.is_dir() else entry.unlink()

    # Features of the hand built image, fuse2fs and the kernel need nothing more.
    call(
        [
            "mke2fs", "-q", "-t", "ext2", "-b", 4096, "-I", 256, "-m", 5,
            "-O", "none,ext_attr,resize_inode,dir_index,filetype,sparse_super,large_file",
            "-E", f"offset={root_start * 512},root_owner=0:0",
            "-d", root, out, root_bytes // 4096,
        ]
    )  # fmt: skip


def compress(image: Path, method: str, keep_raw: bool) -> Path:
    if method == "none":
        return image
    if method == "zstd":
        result = Path(f"{image}.zst")
        call(["zstd", "-T0", "-9", "-f", "-q", image, "-o", result])
    else:
        result = Path(f"{image}.xz")
        call(["xz", "-T0", "-6", "-f", "-k", image])
    if not keep_raw:
        image.unlink()
    return result


# ---------------------------------------------------------------------------
# command line
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="emx-mkimage",
        description="Build a bootable emerixx disk image from aports. Profiles: " + ", ".join(profile_names()),
    )
    p.add_argument("profile", choices=profile_names())
    p.add_argument("-o", "--output", type=Path, help="image file (default: <profile>.img)")
    p.add_argument("--aports", type=Path, default=SCRIPT_DIR.parent, help="aports checkout (default: the one this script is in)")
    p.add_argument("--pull", action="store_true", help="git pull --ff-only the aports first")
    p.add_argument("--repodest", type=Path, default=Path(os.environ.get("REPODEST", Path.home() / "packages")), help="where abuild puts packages (default: ~/packages)")
    p.add_argument("--add", action="append", default=[], type=package_arg, metavar="PKG", help="install another package, repeatable")
    p.add_argument("--build-all", action="store_true", help="build every aport, not only what the profile needs")
    p.add_argument("--no-image", action="store_true", help="only build the packages, do not write an image")
    p.add_argument("--register-repos", action="store_true", help="add each repository abuild fills to /etc/apk/repositories (used by emx-rebuild-all)")
    p.add_argument("--force", action="store_true", help="rebuild packages that already exist")
    p.add_argument("--abuild-flags", default="", help="extra abuild flags")
    p.add_argument("--keep-deps", action="store_true", help="do not uninstall the build dependencies after each package (the builder image keeps them)")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the plan and stop")
    p.add_argument("--image-repo", action="append", default=[], metavar="URL", help="apk repository for /etc/apk/repositories, repeatable")
    p.add_argument("--key", action="append", default=[], type=readable_file, metavar="FILE.pub", help="public key the image trusts, repeatable")
    p.add_argument("--untrusted", action="store_true", help="apk --allow-untrusted")
    p.add_argument("--root-size", type=parse_size, default=parse_size("32G"), help="root filesystem size (default 32G)")
    p.add_argument("--esp-size", type=int, default=64, metavar="MB", help="ESP size in MiB (default 64)")
    p.add_argument("--hostname", type=hostname_arg, default="emerixx")
    p.add_argument("--ip", type=addr_arg, help="static address, without it the network is not configured")
    p.add_argument("--netmask", type=addr_arg, default="255.255.255.0")
    p.add_argument("--gw", type=addr_arg)
    p.add_argument("--dns", action="append", default=[], type=addr_arg, metavar="ADDR")
    p.add_argument("--iface", type=iface_arg, default="en1")
    p.add_argument("--root-password-hash", type=hash_arg, help="crypt(3) hash, root is locked without it")
    p.add_argument("--ssh-key", type=readable_file, metavar="FILE.pub", help="authorized key for root")
    p.add_argument("--compress", choices=("zstd", "xz", "none"), default="zstd")
    p.add_argument("--keep-raw", action="store_true", help="keep the raw image after compressing")
    p.add_argument("--workdir", type=Path, default=Path("/var/tmp"), help="where the root tree is assembled (needs room for the whole image content)")
    return p


def print_plan(profile: Profile, aports: Aports, plan: Plan, todo: list[Step]) -> None:
    for w in aports.warnings:
        print(f"warning: {w}", file=sys.stderr)
    for c in plan.cycles:
        print(f"warning: makedepends cycle {c}, no package can break it, an already built package of the cycle is needed", file=sys.stderr)
    print(f"== Profile {profile.name}: {profile.description}")
    print(f"== {len(plan.install)} packages to install, {len(plan.order)} in the repository, {len(todo)} to build")
    two_pass = [s.aport.key for s in plan.steps if s.stage == "bootstrap"]
    if two_pass:
        print(f"== {len(two_pass)} packages are built in two passes to break dependency cycles: {' '.join(two_pass)}")
    wanted = {id(s) for s in todo}
    for step in plan.steps:
        print(f"  {step.label:<44} {'build' if id(step) in wanted else 'up to date'}")
    if plan.unresolved:
        print(f"== {len(plan.unresolved)} makedepends have no aport and are not installed: {' '.join(plan.unresolved)}")


def run(args: argparse.Namespace) -> int:
    if args.pull:
        call(["git", "-C", args.aports, "pull", "--ff-only"])

    aports = Aports(args.aports)
    profile = load_profile(args.profile)
    plan = make_plan(aports, profile, args.add, args.build_all)
    todo = [s for s in plan.steps if s.needed(args.repodest, args.force)]
    print_plan(profile, aports, plan, todo)
    if args.dry_run:
        return 0

    if os.geteuid() != 0:
        raise Error("must run as root (apk --root, abuild and mke2fs -d need it)")
    if shutil.which("abuild-keygen") and shutil.which("apk"):
        abuild_keys()
        moved = quarantine_untrusted(args.repodest)
        if moved:
            print(f"warning: {len(moved)} packages signed with an unknown key moved to <repo>/untrusted, they are built again", file=sys.stderr)
            todo = [s for s in plan.steps if s.needed(args.repodest, args.force)]
    tools = [] if args.no_image else list(REQUIRED_TOOLS)
    if todo:
        tools.append("abuild")
    if args.compress != "none" and not args.no_image:
        tools.append(args.compress)
    if args.pull:
        tools.append("git")
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        raise Error(f"missing tools: {' '.join(missing)}")

    public_keys = list(args.key)
    if todo:
        build_packages(aports, todo, args.repodest, shlex.split(args.abuild_flags), args.register_repos, args.keep_deps)
    else:
        public_keys += sorted((Path.home() / ".abuild").glob("*.rsa.pub"))
    if args.no_image:
        return 0

    out = (args.output or Path(f"{args.profile}.img")).resolve()
    work = Path(tempfile.mkdtemp(prefix="emx-mkimage.", dir=args.workdir))
    try:
        root = work / "root"
        print(f"== Installing into {root}", flush=True)
        install_root(root, args, plan, public_keys)
        merge_usr(root)
        ship_content(root, args, profile)
        configure_root(root, args, profile)
        print("== Writing the disk", flush=True)
        write_disk(root, out, args.esp_size, args.root_size)
    finally:
        shutil.rmtree(work, ignore_errors=True)

    print(compress(out, args.compress, args.keep_raw))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except Error as e:
        print(f"emx-mkimage: {e}", file=sys.stderr)
    except subprocess.CalledProcessError as e:
        print(f"emx-mkimage: command failed ({e.returncode}): {shlex.join(map(str, e.cmd))}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
