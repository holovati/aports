# Maintainer Damir Holovati

pkgname=gmp
pkgver=6.3.0
pkgrel=0
pkgdesc="free library for arbitrary precision arithmetic"
url="https://gmplib.org/"
arch="all"
license="LGPL-3.0-or-later OR GPL-2.0-or-later"

makedepends="m4 texinfo"

subpackages="$pkgname-static $pkgname-doc"

source="https://gmplib.org/download/gmp/gmp-$pkgver.tar.xz
	"
build() {
	CFLAGS="$CFLAGS -pipe -std=gnu99" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--infodir=/usr/share/info \
		--mandir=/usr/share/man \
		--localstatedir=/var/state/gmp \
		--enable-cxx \
		--enable-shared \
		--enable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
e85a0dab5195889948a3462189f0e0598d331d3457612e2d3350799dba2e244316d256f8161df5219538eb003e4b5343f989aaa00f96321559063ed8c8f29fd2  gmp-6.3.0.tar.xz
"
