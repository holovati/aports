# Maintainer Damir Holovati
pkgname=lcms2
pkgver=2.17
pkgrel=0
pkgdesc="Little CMS color management engine"
url="https://www.littlecms.com/"
arch="all"
license="MIT"
makedepends="meson pkgconf"
options="!check"
source="$pkgname-$pkgver.tar.gz::https://github.com/mm2/Little-CMS/releases/download/lcms$pkgver/lcms2-$pkgver.tar.gz"

build() {
	# Library only. The command line utilities (the only users of
	# libjpeg and libtiff) and the GPL-3 fast-float/threaded plugins
	# are not built.
	abuild-meson \
		-Dutils=false \
		-Djpeg=disabled \
		-Dtiff=disabled \
		-Dfastfloat=false \
		-Dthreaded=false \
		-Dtests=disabled \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
