
# Maintainer Damir Holovati

pkgname=python3

pkgver=3.14.10
pkgrel=0
pkgdesc="High-level scripting language"
url="https://www.python.org/"
arch="all"
license="PSF-2.0"

subpackages="$pkgname-doc"

makedepends="bzip2 ncurses openssl readline xz zlib libffi"

depends="$makedepends"

source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz
	musl-find_library.patch
	add-emerixx-configure.patch
	"

builddir="$srcdir/Python-$pkgver"

# was briefly present, and is in 3.16
provides="pythonispython3=$pkgver-r$pkgrel"

build() {
	export CCSHARED="-fPIC"

	LIBREADLINE_CFLAGS="-I/usr/include" \
	LIBREADLINE_LIBS="-L/usr/lib -lreadline" \
	OPENSSL_CFLAGS="-I/usr/include" \
	OPENSSL_LIBS="-L/usr/lib -lssl -lcrypto" \
	ac_cv_file__dev_ptmx=yes \
	ac_cv_file__dev_ptc=no \
	ac_cv_func_sem_clockwait=no \
	ac_cv_func_close_range=no \
	ac_cv_func_closefrom=no \
	ac_cv_func_fdwalk=no \
	ac_cv_func_posix_spawn_file_actions_addclosefrom_np=no \
	ac_cv_func_rtpSpawn=no \
	ac_cv_func_plock=no \
	ac_cv_have_lchflags=no \
	ac_cv_have_chflags=no \
	ac_cv_func_fork1=no \
	ac_cv_func_sched_getaffinity=no \
	ac_cv_func_epoll=no \
	ac_cv_func_epoll_create=no \
	ac_cv_func_epoll_create1=no \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-ipv6 \
		--enable-shared \
		--without-lto \
		--without-mimalloc \
		--disable-test-modules
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
