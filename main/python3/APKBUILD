
# Maintainer Damir Holovati

pkgname=python3
# the python3-tkinter's pkgver needs to be synchronized with this.
pkgver=3.13.5
_basever="${pkgver%.*}"
pkgrel=0
pkgdesc="High-level scripting language"
url="https://www.python.org/"
arch="all"
license="PSF-2.0"

subpackages="
	$pkgname-dev
	$pkgname-doc
	"

depends="libssl3>=3.3.0"

makedepends="
	bzip2-dev
	ncurses-dev
	openssl-dev
	readline-dev
	xz-dev
	zlib-dev
	"
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz
	musl-find_library.patch
	add-emerixx-configure.patch
	"

builddir="$srcdir/Python-$pkgver"

# was briefly present, and is in 3.16
provides="pythonispython3=$pkgver-r$pkgrel"

prepare() {
	default_prepare
	update_config_guess
	update_config_sub
	sed -i 's/GNU\*)/Emerixx*)/g' configure
}

build() {
	export CCSHARED="-fPIC"

	LIBREADLINE_CFLAGS="-I/usr/include" \
	LIBREADLINE_LIBS="-L/usr/lib -lreadline" \
	OPENSSL_CFLAGS="-I/usr/include" \
	OPENSSL_LIBS="-L/usr/lib -lssl -lcrypto" \
	ac_cv_file__dev_ptmx=yes \
	ac_cv_file__dev_ptc=no \
	ac_cv_have_long_long_format=yes \
    	ac_cv_func_sem_clockwait=no \
    	ac_cv_func_close_range=no \
    	ac_cv_func_closefrom=no \
    	ac_cv_func_fdwalk=no \
    	ac_cv_func_posix_spawn_file_actions_addclosefrom_np=no \
    	ac_cv_func_rtpSpawn=no \
    	ac_cv_func_plock=no \
    	ac_cv_have_lchflags=no \
    	ac_cv_have_chflags=no \
    	ac_cv_func_fork1=no \
	ac_cv_func_sched_getaffinity=no \
	ac_cv_func_epoll=no \
	ac_cv_func_epoll_create=no \
	ac_cv_func_epoll_create1=no \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-ipv6 \
		--enable-shared \
		--without-lto \
		--disable-test-modules
	make
}

package() {
	PYTHON_FOR_BUILD="_PYTHON_CPU_COUNT=1" make DESTDIR="$pkgdir" install COMPILEALL_OPTS="-j 1"	

	#"$pkgdir"/usr/share/man
	#"$pkgdir"/usr/share/info
}

dev() {
	default_dev

	# pyconfig.h is needed runtime so we move it back
	mkdir -p "$pkgdir"/usr/include/python$_basever
	mv "$subpkgdir"/usr/include/python$_basever/pyconfig.h \
		"$pkgdir"/usr/include/python$_basever/
}


