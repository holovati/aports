ab8eaa2858d5109049b1f9f553198d40e0ef8d78211ad6455f7b491af525bffb16738fed60fc84e960c4889568d25753b9e4a1494834fea48291b33f07000ec2  musl-find_library.patch
5dff54772ab6e4b90c0fbe59ec3582b7921bc9b3951aade2263a8904092ffa2d99690078afcbbfbc8fd2014c9cb3b2382b1805c5c63e979495de64b62e4736e8  add-emerixx-configure.patch
"
