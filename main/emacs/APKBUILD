
# Maintainer Damir Holovati

pkgname=emacs
pkgver=30.2
pkgrel=5
_pkgdesc="Extensible, customizable, self-documenting real-time display editor"
pkgdesc="$_pkgdesc (common files)"
url="https://www.gnu.org/software/emacs/emacs.html"
arch="all"
license="GPL-3.0-or-later"

makedepends="gawk gmp ncurses texinfo pkgconf xorgproto
	cairo fontconfig freetype gdk-pixbuf glib gtk3 harfbuzz lcms2 libjpeg-turbo
	libpng libwebp libx11 libxext libxfixes libxft libxi libxinerama libxml2
	libxpm libxrandr libxrender pango sqlite tiff"

# openssl and ca-certificates: no GnuTLS, so tls.el runs `openssl s_client` (needed for MELPA)
depends="ncurses readline cairo fontconfig freetype gdk-pixbuf glib gtk3 harfbuzz
	lcms2 libjpeg-turbo libpng libwebp libx11 libxext libxfixes libxft libxi
	libxinerama libxml2 libxpm libxrandr libxrender pango sqlite tiff
	openssl ca-certificates"

source="https://ftp.gnu.org/gnu/emacs/emacs-$pkgver.tar.xz
	no-git-repo.patch
	"
options="!check"

subpackages="$pkgname-doc"

prepare() {
	  default_prepare
	  emerixx_prepare
	  sed -i 's/\*-\*-linux\* )/*-*-linux* | *-*-emerixx* )/g' configure

	  # configure treats emerixx as gnu-linux, so the splash, about and text startup
	  # screens say "one component of the GNU/Linux operating system". Take the
	  # non-Linux branch of those three checks, which says GNU instead.
	  sed -i "s/(if (eq system-type 'gnu\/linux)/(if nil/" lisp/startup.el
	  [ "$(grep -c "(if nil" lisp/startup.el)" -ge 3 ]
}

build() {
	# GTK3 on X11 with cairo/xft text rendering (harfbuzz shaping). Still off:
	# - dbus, gsettings, gconf: D-Bus is not packaged yet (see gtk3).
	# - gif, rsvg, gnutls, tree-sitter, xwidgets: the libraries are not packaged.
	# File notification uses the kernel inotify.
	./configure \
		--prefix=/usr \
		--build=$CBUILD \
		--host=$CHOST \
		--with-x \
		--with-x-toolkit=gtk3 \
		--with-toolkit-scroll-bars \
		--with-cairo \
		--with-harfbuzz \
		--with-xft \
		--with-xpm \
		--with-jpeg \
		--with-tiff \
		--with-png \
		--with-webp \
		--with-lcms2 \
		--with-xml2 \
		--with-sqlite3 \
		--with-file-notification=inotify \
		--without-gif \
		--without-rsvg \
		--without-imagemagick \
		--without-libotf \
		--without-m17n-flt \
		--without-xaw3d \
		--without-sound \
		--without-pop \
		--without-kerberos \
		--without-kerberos5 \
		--without-hesiod \
		--without-dbus \
		--without-gconf \
		--without-gsettings \
		--without-selinux \
		--without-gnutls \
		--without-gpm \
		--without-tree-sitter \
		--without-xwidgets \
		--disable-acl \
		--without-compress-install

	make
}

package() {
	make DESTDIR="$pkgdir" install

	rm -rf "$pkgdir"/usr/lib/systemd || true 
	rm -rf "$pkgdir"/usr/share/man || true 
}

