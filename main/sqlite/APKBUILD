# Maintainer Damir Holovati
pkgname=sqlite
pkgver=3.54.1
_pkgver=3540100
pkgrel=0
pkgdesc="C library implementing an SQL database engine"
url="https://www.sqlite.org/"
arch="all"
license="blessing"
depends="zlib"
makedepends="zlib"
options="!check"
subpackages="$pkgname-doc"
source="https://www.sqlite.org/2026/sqlite-autoconf-$_pkgver.tar.gz"
builddir="$srcdir/sqlite-autoconf-$_pkgver"

prepare() {
	default_prepare

	# sqlite uses autosetup, which ships its own copies named
	# autosetup-config.{guess,sub}. abuild's update_config_* helpers only
	# look for config.guess/config.sub, so replicate them here with the
	# emerixx-aware versions from abuild's shared directory.
	local f
	for f in guess sub; do
		msg "Updating autosetup/autosetup-config.$f"
		cp "${sharedir:-/usr/share/abuild}/config.$f" \
			"autosetup/autosetup-config.$f" || return 1
	done
}
build() {
	# Same feature set as the common distribution builds; WebKitGTK,
	# libsoup and GLib consumers rely on column metadata, FTS and
	# unlock-notify. No readline: the shell uses its own line editing.
	CFLAGS="$CFLAGS -O2 \
		-DSQLITE_ENABLE_COLUMN_METADATA=1 \
		-DSQLITE_ENABLE_UNLOCK_NOTIFY \
		-DSQLITE_ENABLE_DBSTAT_VTAB=1 \
		-DSQLITE_ENABLE_FTS3_TOKENIZER=1 \
		-DSQLITE_ENABLE_FTS3_PARENTHESIS \
		-DSQLITE_ENABLE_FTS4 \
		-DSQLITE_ENABLE_FTS5 \
		-DSQLITE_ENABLE_RTREE \
		-DSQLITE_ENABLE_JSON1 \
		-DSQLITE_SECURE_DELETE \
		-DSQLITE_SOUNDEX=1 \
		-DSQLITE_USE_URI=1" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-shared \
		--disable-static \
		--disable-readline \
		--enable-threadsafe
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
}

