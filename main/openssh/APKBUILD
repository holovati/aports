# Maintainer Damir Holovati

pkgname=openssh
pkgver=10.6_p2
_myver=${pkgver%_*}${pkgver#*_}
pkgrel=0
pkgdesc="Port of OpenBSD's free SSH release (client, sshd and tools)"
url="https://www.openssh.com/portable.html"
arch="all"
license="BSD-2-Clause AND ISC AND SSH-OpenSSH"
depends="openssl zlib"
makedepends="openssl zlib"
options="!check suid"

install="$pkgname.post-install"
subpackages="$pkgname-doc"

source="https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$_myver.tar.gz
	openssh.post-install
	sshpty-no-ttyname.patch
	"
builddir="$srcdir/openssh-$_myver"

prepare() {
	default_prepare
	emerixx_prepare
}

build() {
	# --without-pam: there is no PAM here; password logins go through
	# /etc/shadow (getspnam) via crypt().
	# --with-privsep-path: sshd chroots into this directory (must be
	# root owned, not writable by anyone else) after authentication.
	# --without-hardening/-stackprotect/-retpoline/-pie: plain build, no
	# toolchain exploit mitigations (relro/now, fortify, canaries, PIE).
	# --with-sandbox=no: no rlimit sandbox (RLIMIT_NOFILE=0 in the
	# privsep child), the child still drops privileges and chroots.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc/ssh \
		--libexecdir=/usr/lib/ssh \
		--mandir=/usr/share/man \
		--with-pid-dir=/run \
		--with-privsep-path=/var/empty \
		--with-privsep-user=sshd \
		--without-pam \
		--without-selinux \
		--without-libedit \
		--without-hardening \
		--without-stackprotect \
		--without-retpoline \
		--without-pie \
		--with-sandbox=no \
		--disable-security-key \
		--disable-strip
	make
}

package() {
	# install-nokeys: skip host key generation, done by the post-install
	# script on the target.
	make DESTDIR="$pkgdir" install-nokeys

	install -dm755 "$pkgdir"/var/empty

	install -Dm644 LICENCE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

