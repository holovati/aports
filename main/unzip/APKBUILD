# Maintainer Damir Holovati

pkgname=unzip
pkgver=6.0
pkgrel=0

_pkgver=${pkgver//./}

pkgdesc="Extract .zip files"

subpackages="$pkgname-doc"

url="http://www.info-zip.org/UnZip.html"
arch="all"
license="custom"

source="https://dev.alpinelinux.org/archive/unzip/unzip$_pkgver.tgz
	gcc15.patch"

builddir="$srcdir/$pkgname$_pkgver"

build() {
    local defines="-DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT -DSYSV -D__GLIBC__"
    defines="$defines -DUNICODE_SUPPORT -DUNICODE_WCHAR -DUTF8_MAYBE_NATIVE -DNO_LCHMOD"
    defines="$defines -DDATE_FORMAT=DF_YMD -DNOMEMCPY -DNO_WORKING_ISPRINT"
    
    make -f unix/Makefile sysv_gcc \
	 LF2="$LDFLAGS" CF="$CFLAGS -std=gnu17 -Wno-format-security $CPPFLAGS -I. $defines" \
	 prefix=/usr
}

check() {
    make -f unix/Makefile check
}

package() {
    make -f unix/Makefile \
	 MANDIR=$pkgdir/usr/share/man/man1/ \
	 prefix=$pkgdir/usr install
}

