# Maintainer Damir Holovati

pkgname=ninja
pkgver=1.13.2
pkgrel=0
pkgdesc="Small build system with a focus on speed"
url="https://ninja-build.org/"
arch="x86_64"
license="Apache-2.0"
makedepends="python3"

checkdepends="gtest"

source="$pkgname-$pkgver.tar.gz::https://github.com/ninja-build/ninja/archive/refs/tags/v$pkgver.tar.gz
	add-emerixx-platform.patch
	"
builddir="$srcdir/ninja-$pkgver"

prepare() {
	default_prepare
}

build() {
	python3 configure.py --verbose --bootstrap	
}

check() {
	./build/ninja_test
}

package() {
	  mkdir -p "$pkgdir"/usr/bin
	  cp -v "$builddir"/ninja "$pkgdir"/usr/bin/ninja
}

