# Maintainer Damir Holovati

pkgname=binutils
pkgver=2.46.0
pkgrel=0
pkgdesc="Tools necessary to build programs"
url="https://www.gnu.org/software/binutils/"

makedepends_build="bison flex texinfo"
makedepends_host="zlib"

arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later AND BSD-3-Clause"
subpackages="$pkgname-doc"

source="https://mirrors.dotsrc.org/gnu/binutils/$pkgname-$pkgver.tar.xz
	emerixx-target.patch
	"

options="!check"

depends="zlib"

prepare() {
	default_prepare
}

build() {
	CFLAGS="$CFLAGS -pipe" \
	CXXFLAGS="$CXXFLAGS -pipe" \
	CPPFLAGS="$CPPFLAGS" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix="/usr" \
		--sysconfdir="/etc" \
        --with-lib-path="/usr/lib:/usr/local/lib:/lib" \
        --libdir="/usr/lib" \
		--with-system-zlib \
		--enable-ld=default \
		--enable-plugins \
		--enable-shared \
		--enable-default-hash-style-gnu \
		--enable-new-dtags \
		--enable-64-bit-bfd \
		--disable-werror \
		--disable-rpath \
		--disable-nls

	make
}

package() {
	make DESTDIR="$pkgdir" install

    # Remove the canonical target directory (e.g. /usr/x86_64-unknown-emerixx-musl)
    # 1. Move ldscripts to the standard /usr/lib location if they were installed in the canonical dir
    if [ -d "$pkgdir"/usr/$CHOST/lib/ldscripts ]; then
        mv "$pkgdir"/usr/$CHOST/lib/ldscripts "$pkgdir"/usr/lib/
    fi

    # 2. Remove the directory (it usually just contains redundant hardlinks to binaries)
    rm -rf "$pkgdir"/usr/$CHOST

}

