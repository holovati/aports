build() {
	:
}

package() {
	install -Dm644 api/EGL/egl.h "$pkgdir"/usr/include/EGL/egl.h
	install -Dm644 api/EGL/eglext.h "$pkgdir"/usr/include/EGL/eglext.h
	install -Dm644 api/EGL/eglplatform.h "$pkgdir"/usr/include/EGL/eglplatform.h
	install -Dm644 api/KHR/khrplatform.h "$pkgdir"/usr/include/KHR/khrplatform.h
}

