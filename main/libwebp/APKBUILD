# Maintainer Damir Holovati
pkgname=libwebp
pkgver=1.5.0
pkgrel=0
pkgdesc="Library and tools for the WebP image format"
url="https://developers.google.com/speed/webp"
arch="all"
license="BSD-3-Clause"
depends="libjpeg libpng zlib"
makedepends="cmake make libjpeg libpng zlib"
options="!check"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$pkgver.tar.gz"

build() {
	# vwebp needs GL/GLUT; GIF and TIFF are not packaged, so gif2webp,
	# anim_* and the extras are left out. cwebp/dwebp use libpng/libjpeg.
	cmake -B build -S . -G "Unix Makefiles" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DWEBP_BUILD_ANIM_UTILS=OFF \
		-DWEBP_BUILD_GIF2WEBP=OFF \
		-DWEBP_BUILD_VWEBP=OFF \
		-DWEBP_BUILD_EXTRAS=OFF \
		-DWEBP_BUILD_CWEBP=ON \
		-DWEBP_BUILD_DWEBP=ON \
		-DWEBP_BUILD_IMG2WEBP=ON \
		-DWEBP_BUILD_WEBPINFO=ON \
		-DWEBP_BUILD_WEBPMUX=ON \
		-DWEBP_BUILD_LIBWEBPMUX=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
