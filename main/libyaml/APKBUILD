# Maintainer Damir Holovati
pkgname=libyaml
pkgver=0.2.5
pkgrel=0
pkgdesc="YAML 1.1 parser and emitter written in C"
url="https://pyyaml.org/wiki/LibYAML"
arch="all"
license="MIT"
options="!check"
source="https://pyyaml.org/download/libyaml/yaml-$pkgver.tar.gz"
builddir="$srcdir/yaml-$pkgver"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
}

sha512sums="
