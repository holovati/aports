# Maintainer Damir Holovati
pkgname=e2fsprogs
pkgver=1.47.4
pkgrel=3
pkgdesc="Standard Ext2/3/4 filesystem utilities"
url="https://e2fsprogs.sourceforge.net/"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.0-or-later AND BSD-3-Clause AND MIT"
options="!check"

makedepends="util-linux gawk fuse3"

checkdepends="diffutils perl coreutils"

subpackages="
	fuse2fs
	fuse2fs-doc:fuse2fs_doc:noarch
	$pkgname-doc
	"

source="$pkgname-$pkgver.tar.gz::https://github.com/tytso/e2fsprogs/archive/v$pkgver.tar.gz
	always-build-static-fuse2fs.patch
	"

build() {
	sed -i 's/-pg//g' "misc/Makefile.in"

	ac_cv_func_llistxattr=no \
	ac_cv_header_sys_xattr_h=no \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-nls \
		--disable-fsck \
		--disable-profile \
		--disable-lto

	make -j1 all all-static
}

check() {
	# Disable failing test
	rm -rf tests/m_offset*

	# Failing on CI
	rm -rf tests/f_bigalloc_orphan_list*

	# Fails on armhf on CI
	rm -rf tests/f_extent_htree*

	# Fails on builders with less than 4TB free space
	rm -rf tests/m_hugefile

	make check
}

package() {
	make DESTDIR="$pkgdir" install

	install -m 0755 e2fsck/e2fsck.static "$pkgdir/usr/sbin"

	# conflict with sysvinit
	rm "$pkgdir"/usr/sbin/logsave

	for f in "$pkgdir"/usr/share/man/man*/*; do
	    cp --remove-destination "$(readlink -f "$f")" "$f.tmp"
	    mv "$f.tmp" "$f"
	done
}

fuse2fs() {
	pkgdesc="Ext2/3/4 filesystem driver for FUSE"
	amove usr/bin/fuse2fs*
}

fuse2fs_doc() {
	pkgdesc="Ext2/3/4 filesystem driver for FUSE (documentation)"
	install_if="fuse2fs=$pkgver-r$pkgrel docs"

	amove usr/share/man/man1/fuse2fs.1
	gzip -9 "$subpkgdir"/usr/share/man/man1/fuse2fs.1
}


