b0f751c9f58d90a5a486798476e0145cc0e5087385fff00c3f90c40823bc09f18fc7ae04e89739c55d259faf53a87566a1e89015a68c8e0edad59c7834d4a87a  always-build-static-fuse2fs.patch
"
