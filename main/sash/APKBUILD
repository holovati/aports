# Maintainer Damir Holovati
pkgname=sash
pkgver=3.8
pkgrel=0
pkgdesc="A stand-alone shell with many built-in commands"
url="https://members.tip.net.au/~dbell"
arch="all"
license="MIT"
subpackages="$pkgname-doc"

options="!check"

source="https://members.tip.net.au/~dbell/programs/sash-$pkgver.tar.gz
	disable-linux-features.patch"

build() {	
	make
}

package() {
	install -dm755 "$pkgdir"/usr/sbin
	install -dm755 "$pkgdir"/usr/share/man/man1
	
	make DESTDIR="$pkgdir" BINDIR=usr/sbin MANDIR=usr/share/man install
}

