# Maintainer Damir Holovati	
pkgname=xorgproto
pkgver=2025.1
pkgrel=0
pkgdesc="Combined X.Org X11 protocol headers"
url="https://www.x.org"
arch="noarch"
license="BSD-2-Clause AND MIT AND X11"
makedepends="meson util-macros"
source="https://xorg.freedesktop.org/archive/individual/proto/xorgproto-$pkgver.tar.gz"
options="!check" # no tests

build() {
	abuild-meson \
		-Dxorg=true \
		-Dxephyr=false \
		-Dxwayland=false \
		-Dxwayland_ei=false \
		-Dglamor=false \
		-Dxnest=false \
		-Dxvfb=false \
		-Dxwin=false \
		-Dxquartz=false \
		-Dglx=false \
		-Dxdmcp=false \
		-Dxdm-auth-1=false \
		-Dinput_thread=auto \
		-Dlisten_tcp=false \
		-Dlisten_unix=true \
		-Dlisten_local=true \
		-Dfallback_input_driver=auto \
		-Ddtrace=false \
		-Dint10=false \
		-Dsuid_wrapper=false \
		-Dpciaccess=false \
		-Dudev=false \
		-Dudev_kms=false \
		-Dhal=false \
		-Dsystemd_notify=false \
		-Dsystemd_logind=false \
		-Dvgahw=false \
		-Ddpms=false \
		-Dxf86bigfont=false \
		-Dscreensaver=false \
		-Dxres=true \
		-Dxace=false \
		-Dxselinux=false \
		-Dxinerama=false \
		-Dxcsecurity=false \
		-Dxv=false \
		-Dxvmc=false \
		-Ddga=false \
		-Dlinux_apm=false \
		-Dlinux_acpi=false \
		-Dmitshm=true \
		-Dagp=false \
		-Dxf86-input-inputtest=false \
		-Ddri1=false \
		-Ddri2=false \
		-Ddri3=false \
		-Ddrm=false \
		-Dlibunwind=false \
		-Ddocs=false \
		-Ddevel-docs=false \
		-Ddocs-pdf=false \
		. output

	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# cleanup
	rm -f "$pkgdir"/usr/include/X11/extensions/apple*
	rm -f "$pkgdir"/usr/include/X11/extensions/windows*
	rm -f "$pkgdir"/usr/lib/pkgconfig/apple*
	rm -f "$pkgdir"/usr/lib/pkgconfig/windows*
	rm -f "$pkgdir"/usr/include/X11/extensions/vldXvMC.h # libxvmc-dev >= 1.0.12-r0
	rm -f "$pkgdir"/usr/include/X11/extensions/XKBgeom.h # libx11-dev >= 1.6.9-r0
}

sha512sums="
053504c8fbaf952825c4c179e8de8c3502d816b961bc483b5d4f968a41a89802c71932d8073e7b3e4ffea61bf42596e98599c6ea5c750bb48ee5514916e7e387  xorgproto-2025.1.tar.gz
"
