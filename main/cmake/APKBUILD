# Maintainer Damir Holovati

pkgname=cmake
pkgver=3.31.6
pkgrel=0
pkgdesc="Cross-platform, open-source build system"
url="https://cmake.org/"
arch="x86_64"
license="BSD-3-Clause"
depends="openssl"
makedepends="make ninja openssl"

# The Emerixx kernel has no epoll, so the bundled libuv is built with its
# poll()-based POSIX backend (see cmake-emerixx.patch).
source="$pkgname-$pkgver.tar.gz::https://github.com/Kitware/CMake/releases/download/v$pkgver/cmake-$pkgver.tar.gz
	cmake-emerixx.patch
	"
builddir="$srcdir/cmake-$pkgver"

prepare() {
	default_prepare
}

build() {
	# Stage 1: ./bootstrap builds a minimal cmake with make (uses poll()
	# only). Stage 2: that cmake configures and builds the real one with
	# ninja, using bundled third-party libraries.
	./bootstrap \
		--prefix=/usr \
		--mandir=/share/man \
		--docdir=/share/doc/cmake \
		--parallel="${JOBS:-1}" \
		--generator=Ninja \
		--no-qt-gui \
		--no-debugger \
		-- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_USE_OPENSSL=ON \
		-DBUILD_TESTING=OFF
	ninja
}

package() {
	DESTDIR="$pkgdir" ninja install
}

