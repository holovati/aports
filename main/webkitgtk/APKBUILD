	"
options="!check"
source="https://webkitgtk.org/releases/webkitgtk-$pkgver.tar.xz"

prepare() {
	default_prepare
	emerixx_prepare | true

	# gcc here defines __emerixx__ but not __linux__, and CMAKE_SYSTEM_NAME
	# is Emerixx, so WebKit would pick its generic OS fallbacks, which do
	# not even compile (memoryStatus() is only declared for OS(LINUX)).
	# The kernel ABI and musl are Linux-like, so treat it as Linux.
	sed -i 's/^#if defined(__linux__)$/#if defined(__linux__) || defined(__emerixx__)/' \
		Source/WTF/wtf/PlatformOS.h
	sed -i 's/^#ifdef __linux__$/#if defined(__linux__) || defined(__emerixx__)/' \
		Source/bmalloc/bmalloc/BPlatform.h \
		Source/bmalloc/libpas/src/libpas/pas_platform.h
	sed -i 's/CMAKE_SYSTEM_NAME MATCHES "Linux")/CMAKE_SYSTEM_NAME MATCHES "Linux|Emerixx")/' \
		Source/WTF/wtf/CMakeLists.txt \
		Source/WTF/wtf/PlatformGTK.cmake \
		Source/JavaScriptCore/CMakeLists.txt \
		Source/cmake/OptionsGTK.cmake \
		Source/cmake/WebKitCommon.cmake

	# There are no kernel headers in the sysroot, the GPL-free uapi copies
	# live in <emerixx/...>. libpas only needs the futex constants.
	sed -i 's|<linux/futex.h>|<emerixx/futex_ops.h>|' \
		Source/bmalloc/libpas/src/libpas/pas_lock.c

	# renderBufferDescription() is only defined under USE(LIBDRM), but the
	# fallback branch of handleGPU() calls it for every GTK build. Upstream
	# bug that only shows with -DUSE_LIBDRM=OFF.
	perl -0pi -e 's/#if PLATFORM\(GTK\)\n(\s+addTableRow\(hardwareAccelerationObject, "Buffer format"_s, renderBufferDescription\(request\)\);\n#endif)/#if PLATFORM(GTK) && USE(LIBDRM)\n$1/' \
		Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp
	grep -q 'PLATFORM(GTK) && USE(LIBDRM)' \
		Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp

	# DMABufBuffer::createEGLImage() is only compiled with USE(GBM), but
	# the GTK UI process calls it unconditionally, which fails at link
	# time with -DUSE_GBM=OFF. Without GBM no DMABuf buffers are
	# negotiated anyway, so make BufferEGLImage::create() fail cleanly.
	perl -0pi -e 's/    auto\* image = DMABufBuffer::createEGLImage\(\*glDisplay, dmaBufAttributes\);\n/#if USE(GBM)\n    auto* image = DMABufBuffer::createEGLImage(*glDisplay, dmaBufAttributes);\n#else\n    EGLImage image = nullptr;\n#endif\n/' \
		Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.cpp
	grep -q 'EGLImage image = nullptr;' \
		Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.cpp

	# rendererBufferTransportMode() queries EGL (eglQueryString) before
	# looking at anything else. libepoxy dlopen()s libEGL.so.1 for that
	# and abort()s when it is missing, which kills the UI process at
	# startup. There is no EGL/GL implementation here: an empty mode
	# makes WebKit turn hardware acceleration off and use the Skia CPU
	# path with shared memory buffers.
	perl -0pi -e 's/(    std::call_once\(onceFlag, \[\] \{\n)(        const char\* disableDMABuf = getenv\("WEBKIT_DISABLE_DMABUF_RENDERER"\);)/$1#if !USE(GBM)\n        return;\n#endif\n$2/' \
		Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.cpp
	grep -q -B1 -A1 '^#if !USE(GBM)$' \
		Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.cpp

	# SharedMemory only tries memfd_create() when <linux/memfd.h> exists
	# (HAVE_LINUX_MEMFD_H), and there are no kernel headers here, so it
	# falls back to shm_open() on /dev/shm. musl has memfd_create() and
	# MFD_CLOEXEC in <sys/mman.h>; use that instead of the raw syscall.
	# memfd_create() failing with ENOSYS still falls back to shm_open().
	sed -i \
		-e 's|^#if HAVE(LINUX_MEMFD_H)$|#if 1|' \
		-e 's|^#include <linux/memfd.h>$|#include <sys/mman.h>|' \
		-e 's|syscall(__NR_memfd_create, "WebKitSharedMemory", MFD_CLOEXEC)|memfd_create("WebKitSharedMemory", MFD_CLOEXEC)|' \
		Source/WebCore/platform/unix/SharedMemoryUnix.cpp
	grep -q 'memfd_create("WebKitSharedMemory", MFD_CLOEXEC)' \
		Source/WebCore/platform/unix/SharedMemoryUnix.cpp
}

build() {
	# - The JIT tiers (LLInt, Baseline, DFG, FTL), WebAssembly and bmalloc
	#   are left at their x86_64 defaults and need PROT_EXEC mappings from
	#   the kernel. If that misbehaves, fall back to -DENABLE_JIT=OFF
	#   -DENABLE_C_LOOP=ON -DENABLE_WEBASSEMBLY=OFF -DUSE_SYSTEM_MALLOC=ON.
	#   Only the sampling profiler is off, as it needs signal based thread
	#   suspension with register access.
	# - Everything pulling in GStreamer (video, audio, web audio, codecs,
	#   speech) is off, as are WebGL (no GL stack yet), the GPU process
	#   (needs GBM/DRM), the bubblewrap sandbox, Wayland, gamepad, spell
	#   checking, libsecret, hyphenation, AVIF/JPEG XL and journald.
	#   pdf.js is bundled in the tarball and only needs glib's
	#   glib-compile-resources, so it stays on.
	# - Accessibility goes over plain GDBus, so there is no hard dependency
	#   on at-spi2-core. It stays inactive until there is a D-Bus.
	# - The bundled unifdef is used. Unified builds stay at their default
	#   (on): WebKit sources rely on the includes of their bundle
	#   neighbours and do not compile standalone (Repatch.cpp lacks
	#   CallLinkInfo.h). Peak memory per compiler process is higher, so
	#   keep JOBS low.
	cmake -B build -S . -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=libexec \
		-DCMAKE_SKIP_RPATH=ON \
		-DPORT=GTK \
		-DUSE_GTK4=OFF \
		-DDEVELOPER_MODE=OFF \
		-DLTO_MODE=OFF \
		-DUSE_LD_LLD=OFF \
		-DENABLE_SAMPLING_PROFILER=OFF \
		-DENABLE_INTROSPECTION=OFF \
		-DENABLE_DOCUMENTATION=OFF \
		-DENABLE_BUBBLEWRAP_SANDBOX=OFF \
		-DENABLE_MINIBROWSER=OFF \
		-DENABLE_WEBDRIVER=OFF \
		-DENABLE_GAMEPAD=OFF \
		-DENABLE_SPELLCHECK=OFF \
		-DENABLE_SPEECH_SYNTHESIS=OFF \
		-DUSE_GSTREAMER=OFF \
		-DENABLE_VIDEO=OFF \
		-DENABLE_WEB_AUDIO=OFF \
		-DENABLE_WEB_CODECS=OFF \
		-DENABLE_MEDIA_RECORDER=OFF \
		-DENABLE_MEDIA_SESSION=OFF \
		-DENABLE_MEDIA_STREAM=OFF \
		-DENABLE_MEDIA_CONTROLS_CONTEXT_MENUS=OFF \
		-DENABLE_WEBGL=OFF \
		-DENABLE_GPU_PROCESS=OFF \
		-DENABLE_JOURNALD_LOG=OFF \
		-DENABLE_WAYLAND_TARGET=OFF \
		-DENABLE_X11_TARGET=ON \
		-DUSE_GBM=OFF \
		-DUSE_LIBDRM=OFF \
		-DUSE_LIBSECRET=OFF \
		-DUSE_LIBHYPHEN=OFF \
		-DUSE_AVIF=OFF \
		-DUSE_JPEGXL=OFF \
		-DUSE_LIBBACKTRACE=OFF \
		-DUSE_SYSPROF_CAPTURE=OFF \
		-DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
		-DUSE_SYSTEM_UNIFDEF=OFF
	cmake --build build -j"${JOBS:-2}"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

