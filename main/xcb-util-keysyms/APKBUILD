# Maintainer Damir Holovati
pkgname=xcb-util-keysyms
pkgver=0.4.1
pkgrel=0
pkgdesc="XCB keysym utilities"
url="https://xcb.freedesktop.org/"
arch="all"
license="MIT"
depends_dev="libxcb xorgproto"
makedepends="$depends_dev util-macros"
source="https://xcb.freedesktop.org/dist/xcb-util-keysyms-$pkgver.tar.xz"

build() {
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
