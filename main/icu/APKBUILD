# Maintainer Damir Holovati
pkgname=icu
pkgver=79.1
pkgrel=0
pkgdesc="International Components for Unicode library"
url="https://icu.unicode.org/"
arch="all"
license="Unicode-3.0"
options="!check"
subpackages="$pkgname-doc"
source="https://github.com/unicode-org/icu/releases/download/release-$pkgver/icu4c-$pkgver-sources.tgz"
builddir="$srcdir/icu/source"

prepare() {
	default_prepare
	emerixx_prepare

	# configure only knows Linux-like hosts for the mh-linux makefile
	# fragment, the genccode assembly mode and the U_LINUX platform. Treat
	# emerixx the same (musl, ELF, GNU toolchain).
	sed -i \
		-e 's/^\([[:space:]]*\)\*-\*-linux\*|\*-\*-gnu|/\1*-*-linux*|*-*-emerixx*|*-*-gnu|/' \
		-e 's/^\*-linux\*|\*-kfreebsd\*-gnu\*|/*-linux*|*-emerixx*|*-kfreebsd*-gnu*|/' \
		configure
	grep -q 'emerixx' configure || die "configure patch did not apply"
}

build() {
	# Native build, no separate cross stage. Tests, samples and extras are
	# not built.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static \
		--disable-tests \
		--disable-samples \
		--disable-extras
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
