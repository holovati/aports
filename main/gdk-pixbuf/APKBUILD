# Maintainer Damir Holovati
pkgname=gdk-pixbuf
pkgver=2.42.12
pkgrel=0
pkgdesc="Image loading library for GTK"
url="https://gitlab.gnome.org/GNOME/gdk-pixbuf"
arch="all"
license="LGPL-2.1-or-later"
depends="glib libjpeg libpng tiff"
makedepends="glib libjpeg libpng tiff meson pkgconf python3"
options="!check"
source="https://download.gnome.org/sources/gdk-pixbuf/${pkgver%.*}/gdk-pixbuf-$pkgver.tar.xz"

build() {
	# All loaders are built in, so there is no loaders.cache to maintain.
	# gio_sniffing needs shared-mime-info, which is not packaged.
	abuild-meson \
		-Dpng=enabled \
		-Djpeg=enabled \
		-Dtiff=enabled \
		-Dgif=enabled \
		-Dothers=disabled \
		-Dbuiltin_loaders=all \
		-Dgio_sniffing=false \
		-Dintrospection=disabled \
		-Dman=false \
		-Dgtk_doc=false \
		-Ddocs=false \
		-Dtests=false \
		-Dinstalled_tests=false \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
