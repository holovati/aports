# Maintainer Damir Holovati
pkgname=harfbuzz
pkgver=11.3.2
pkgrel=1
pkgdesc="Text shaping library"
url="https://harfbuzz.github.io/"
arch="all"
license="MIT"
depends="freetype glib"
makedepends="freetype glib meson pkgconf"
options="!check"
subpackages="$pkgname-doc"
source="https://github.com/harfbuzz/harfbuzz/releases/download/$pkgver/harfbuzz-$pkgver.tar.xz"

build() {
	# First build: FreeType and GLib only. Rebuild with cairo (hb-view),
	# ICU (needed by WebKitGTK) and graphite2 once those are packaged.
	abuild-meson \
		-Dglib=enabled \
		-Dgobject=enabled \
		-Dfreetype=enabled \
		-Dcairo=disabled \
		-Dicu=disabled \
		-Dgraphite=disabled \
		-Dintrospection=disabled \
		-Ddocs=disabled \
		-Dtests=disabled \
		-Dbenchmark=disabled \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
