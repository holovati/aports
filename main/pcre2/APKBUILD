# Maintainer Damir Holovati
pkgname=pcre2
pkgver=10.44
pkgrel=0
pkgdesc="Perl-compatible regular expression library"
url="https://github.com/PCRE2Project/pcre2"
arch="all"
license="BSD-3-Clause"
makedepends="bzip2 zlib"
options="!check"
subpackages="$pkgname-static $pkgname-doc"
source="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$pkgver/pcre2-$pkgver.tar.bz2"

build() {
	# JIT is off: it needs executable anonymous mappings (PROT_EXEC) and
	# neither glib nor WebKit use PCRE2's JIT.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--enable-shared \
		--enable-static \
		--enable-pcre2-16 \
		--enable-pcre2-32 \
		--enable-unicode \
		--disable-jit \
		--enable-pcre2grep-libz \
		--enable-pcre2grep-libbz2
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
