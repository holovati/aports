# Maintainer Damir Holovati
pkgname=tiff
pkgver=4.7.0
pkgrel=0
pkgdesc="Library and tools for the Tag Image File Format (TIFF)"
url="https://libtiff.gitlab.io/libtiff/"
arch="all"
license="libtiff"
depends="libjpeg-turbo xz zlib"
makedepends="cmake make libjpeg xz zlib"
options="!check"
#source="https://download.osgeo.org/libtiff/tiff-$pkgver.tar.gz"
source="https://mirror.sg.gs/debian-security/pool/main/t/tiff/tiff_$pkgver.orig.tar.bz2"

builddir="$srcdir/libtiff-v$pkgver"

build() {
	# Optional codecs that are not packaged (jbig, lerc, libdeflate) and the OpenGL viewer, C++ API, docs, tests and
	# contrib programs are left out.
	cmake -B build -S . -G "Unix Makefiles" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-Dtiff-tools=ON \
		-Dtiff-tests=OFF \
		-Dtiff-contrib=OFF \
		-Dtiff-docs=OFF \
		-Dtiff-opengl=OFF \
		-Dcxx=OFF \
		-Dzlib=ON \
		-Djpeg=ON \
		-Dlzma=ON \
		-Dwebp=ON \
		-Dzstd=ON \
		-Djbig=OFF \
		-Dlerc=OFF \
		-Dlibdeflate=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
