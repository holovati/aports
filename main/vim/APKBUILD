# Maintainer Damir Holovati
pkgname=vim
pkgver=9.2.1332
pkgrel=1
pkgdesc="Improved vi-style text editor"
url="https://www.vim.org"
arch="all"
license="Vim"
makedepends="gtk3 ncurses libx11 libxt libsm libice pkgconf"
# Same layout as Alpine: vim is the terminal-only build, gvim the GTK3 one. The files both
# builds share (the runtime directory) are in vim-common, so gvim does not duplicate them.
# gvim provides vim at a lower priority, so a plain "apk add vim" never pulls in GTK.
subpackages="$pkgname-doc $pkgname-common::noarch xxd gvim"
options="!check" # the test suite needs a pty, a display and a lot of tooling
source="$pkgname-$pkgver.tar.gz::https://github.com/vim/vim/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare

	# The GUI edition is configured and built in a copy of the tree.
	cp -RT "$builddir" "$builddir"-gvim
}

_build() {
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--with-features=normal \
		--enable-multibyte \
		--disable-nls \
		--disable-gpm \
		--disable-sysmouse \
		--disable-selinux \
		--disable-acl \
		--disable-canberra \
		--disable-netbeans \
		--disable-pythoninterp \
		--disable-python3interp \
		--disable-perlinterp \
		--disable-rubyinterp \
		--disable-luainterp \
		--disable-tclinterp \
		--disable-cscope \
		--disable-darwin \
		--disable-smack \
		"$@"
	make
}

build() {
	_build --without-x --enable-gui=no

	cd "$builddir"-gvim
	_build --with-x --enable-gui=gtk3
}

package() {
	depends="ncurses vim-common=$pkgver-r$pkgrel xxd=$pkgver-r$pkgrel"
	provider_priority=10
	# The vi package ships the same /usr/bin/vi, ex and view names.
	replaces="vi gvim"

	make -j1 DESTDIR="$pkgdir" install

	# Only relevant to gvim.
	rm -rf "$pkgdir"/usr/share/icons "$pkgdir"/usr/share/applications
}

common() {
	pkgdesc="$pkgdesc (common files)"
	replaces="vi vim gvim"

	amove usr/share/vim
}

xxd() {
	pkgdesc="Tool to make (or reverse) a hex dump"
	depends=""
	replaces="vi vim gvim"

	amove usr/bin/xxd
}

gvim() {
	pkgdesc="$pkgdesc (GTK3 GUI)"
	depends="ncurses font-dejavu gtk3 vim-common=$pkgver-r$pkgrel xxd=$pkgver-r$pkgrel"
	provides="vim=$pkgver-r$pkgrel"
	provider_priority=1
	replaces="vi vim"

	make -C "$builddir"-gvim -j1 DESTDIR="$subpkgdir" install

	# The terminal edition's package has these.
	rm -f "$subpkgdir"/usr/bin/vimdiff "$subpkgdir"/usr/bin/vimtutor "$subpkgdir"/usr/bin/xxd
	rm -rf "$subpkgdir"/usr/share/man "$subpkgdir"/usr/share/vim

	# A silent fallback to a console-only build must not go unnoticed.
	test -e "$subpkgdir"/usr/bin/gvim || return 1
}

doc() {
	replaces="vi-doc"
	default_doc
}

sha512sums="
6df4696af4fc07a78085b2cad4dc74b354733e610b6b66fccc549aceeb326991814464e748c849d18880a7e94253c4fe2c4420e4a5780e5d5b1fa3972ad02bb7  vim-9.2.1332.tar.gz
"
