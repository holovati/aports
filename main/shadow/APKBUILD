# Maintainer Damir Holovati
pkgname=shadow
pkgver=4.20.3
pkgrel=0
pkgdesc="Login and password utilities (passwd, su, login, useradd, ...)"
url="https://github.com/shadow-maint/shadow"
arch="all"
license="BSD-3-Clause"
depends="emx-baselayout"
options="suid !check"
subpackages="$pkgname-doc"

source="https://github.com/shadow-maint/shadow/releases/download/$pkgver/shadow-$pkgver.tar.xz
	readpassphrase.c
	readpassphrase.h
	"

build() {
	# musl has no readpassphrase(3) and libbsd is not packaged. shadow needs it for password
	# prompts, so build a minimal one and link it in statically. It is not installed.
	${CC:-gcc} $CFLAGS -I"$srcdir" -c "$srcdir"/readpassphrase.c -o "$srcdir"/readpassphrase.o
	${AR:-ar} rcs "$srcdir"/libreadpassphrase.a "$srcdir"/readpassphrase.o

	# --without-libpam: there is no PAM. passwd, su, login, chpasswd, ... authenticate against
	# /etc/shadow with crypt() directly.
	# --without-libbsd: use the readpassphrase above (and shadow's own freezero).
	# --without-yescrypt: musl crypt() does not do yescrypt. ENCRYPT_METHOD is SHA512.
	# --disable-subordinate-ids: needs user namespaces (newuidmap, newgidmap), we have none.
	# --without-acl/selinux/audit/tcb/nscd/btrfs: not available.
	CPPFLAGS="$CPPFLAGS -I$srcdir" \
	LIBS="$srcdir/libreadpassphrase.a" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--bindir=/usr/bin \
		--sbindir=/usr/sbin \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-nls \
		--disable-logind \
		--disable-static \
		--disable-subordinate-ids \
		--without-libpam \
		--without-libbsd \
		--without-yescrypt \
		--without-audit \
		--without-selinux \
		--without-acl \
		--without-tcb \
		--without-nscd \
		--without-btrfs
	make
}

package() {
	make DESTDIR="$pkgdir" install

	# Replace the shipped login.defs, it documents a lot of things shadow no longer reads.
	cat > "$pkgdir"/etc/login.defs <<-'EOF'
		# /etc/login.defs: shadow login suite configuration

		ENCRYPT_METHOD SHA512
		USERGROUPS_ENAB yes
		UMASK 022

		PASS_MAX_DAYS 99999
		PASS_MIN_DAYS 0
		PASS_WARN_AGE 7

		UID_MIN 1000
		UID_MAX 60000
		SYS_UID_MIN 100
		SYS_UID_MAX 999
		GID_MIN 1000
		GID_MAX 60000
		SYS_GID_MIN 100
		SYS_GID_MAX 999

		LOGIN_RETRIES 5
		LOGIN_TIMEOUT 60
		LOG_OK_LOGINS no
		LOG_UNKFAIL_ENAB no
		FAILLOG_ENAB no
		LASTLOG_ENAB no
		SYSLOG_SU_ENAB no
		SYSLOG_SG_ENAB no
		HUSHLOGIN_FILE .hushlogin
		MAIL_DIR /var/mail

		ENV_SUPATH PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
		ENV_PATH PATH=/usr/local/bin:/usr/bin:/bin

		TTYGROUP tty
		TTYPERM 0620

		CHFN_RESTRICT rwh
		ERASECHAR 0177
		KILLCHAR 025
	EOF

	install -dm755 "$pkgdir"/etc/default
	cat > "$pkgdir"/etc/default/useradd <<-'EOF'
		GROUP=100
		HOME=/home
		INACTIVE=-1
		EXPIRE=
		SHELL=/bin/bash
		SKEL=/etc/skel
		CREATE_MAIL_SPOOL=no
	EOF

	install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}

