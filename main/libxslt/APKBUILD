# Maintainer Damir Holovati
pkgname=libxslt
pkgver=1.1.43
pkgrel=0
pkgdesc="XSLT processing library and xsltproc"
url="https://gitlab.gnome.org/GNOME/libxslt"
arch="all"
license="X11"
depends="libxml2"
makedepends="libxml2 zlib"
options="!check"
subpackages="$pkgname-doc"
source="https://download.gnome.org/sources/libxslt/${pkgver%.*}/libxslt-$pkgver.tar.xz"

build() {
	# No python bindings and no libgcrypt (EXSLT crypto) for now.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static \
		--without-python \
		--without-crypto
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
}

sha512sums="
