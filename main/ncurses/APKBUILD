# Maintainer Damir Holovati
pkgname=ncurses
pkgver=6.6
pkgrel=0
pkgdesc="Console display library"
url="https://invisible-island.net/ncurses/"
arch="all"
options="!check" # "tests" are actual demo programs, not a test suite.
license="X11"
subpackages="$pkgname-doc $pkgname-static"

source="https://ftp.gnu.org/gnu/ncurses/ncurses-$pkgver.tar.gz
	cleanup-pkgconfig-ldflags.patch
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	emerixx_prepare
	
	# We won't be able to build shared libraries unless we add emerixx to the supoorted os test
	sed -i 's/k\*bsd\*-gnu/emerixx*|k*bsd*-gnu/g' configure
}

build() {
	CFLAGS="$CFLAGS -pipe" \
	CXXFLAGS="$CFLAGS -pipe" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--mandir=/usr/share/man \
		--without-ada \
		--without-tests \
		--disable-termcap \
		--disable-rpath-hack \
		--disable-setuid-environ \
		--disable-stripping \
		--with-pkg-config-libdir=/usr/lib/pkgconfig \
		--with-cxx-binding \
		--with-cxx-shared \
		--with-terminfo-dirs="/usr/share/terminfo:/lib/terminfo:/usr/lib/terminfo:/etc/terminfo" \
		--enable-pc-files \
		--enable-symlinks \
		--with-shared \
		--enable-widec \
		--enable-ext-colors \
		--enable-ext-mouse \
		--with-termlib \
		--with-ticlib
		
	make
}

package() {
	make DESTDIR="$pkgdir" install

    # Create symlinks for non-wide libraries
    cd "$pkgdir"/usr/lib
    local lib
    for lib in ncurses ncurses++ form panel menu tic tinfo; do
        [ -f "lib${lib}w.so" ] && ln -s "lib${lib}w.so" "lib${lib}.so"
        [ -f "lib${lib}w.a" ] && ln -s "lib${lib}w.a" "lib${lib}.a"
        [ -f "pkgconfig/${lib}w.pc" ] && ln -s "${lib}w.pc" "pkgconfig/${lib}.pc"
    done
}

