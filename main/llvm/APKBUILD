# Maintainer Damir Holovati

pkgname=llvm
pkgver=23.1.6
pkgrel=0
pkgdesc="Low Level Virtual Machine compiler infrastructure"
url="https://llvm.org/"
arch="x86_64"
license="Apache-2.0 WITH LLVM-exception"
options="!check"

# One build, split into separate apks. clang-format only pulls clang + llvm-libs.
subpackages="$pkgname-libs clang clang-tools-extra:clang_tools_extra"

depends="$pkgname-libs=$pkgver-r$pkgrel"

makedepends="cmake ninja python3 zlib zstd libxml2"

source="llvm-project-$pkgver.src.tar.xz::https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver/llvm-project-$pkgver.src.tar.xz
	TripleName.def.patch
	Triple.h.patch
	OSTargets.h.patch
	Targets.cpp.patch
	Driver.cpp.patch
	Linux.cpp.patch
	CMakeLists.txt.patch
	Emerixx.h
	Emerixx.cpp
	"

builddir="$srcdir/llvm-project-$pkgver.src"

prepare() {
	default_prepare

	# The Emerixx toolchain is a new file, not a patch to an existing one.
	cp "$srcdir"/Emerixx.h "$builddir"/clang/lib/Driver/ToolChains/Emerixx.h
	cp "$srcdir"/Emerixx.cpp "$builddir"/clang/lib/Driver/ToolChains/Emerixx.cpp
}

build() {
	# X86 only (the only arch emerixx runs on). No LTO, no PIE (the kernel
	# does not support PIE executables); shared-lib PIC is fine. libedit is
	# skipped (no aport), so opt/llc fall back to a plain fgets editor.
	cmake -B build -S llvm -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DLLVM_ENABLE_PROJECTS="clang;clang-tools-extra" \
		-DLLVM_TARGETS_TO_BUILD=X86 \
		-DLLVM_BUILD_LLVM_DYLIB=ON \
		-DLLVM_LINK_LLVM_DYLIB=ON \
		-DLLVM_ENABLE_LIBEDIT=OFF \
		-DLLVM_ENABLE_TERMINFO=OFF \
		-DLLVM_ENABLE_FFI=OFF \
		-DLLVM_ENABLE_LTO=OFF \
		-DLLVM_INCLUDE_TESTS=OFF \
		-DLLVM_INCLUDE_BENCHMARKS=OFF \
		-DLLVM_INCLUDE_EXAMPLES=OFF \
		-DLLVM_INCLUDE_DOCS=OFF \
		-DLLVM_ENABLE_ZLIB=ON \
		-DLLVM_ENABLE_ZSTD=ON \
		-DLLVM_ENABLE_LIBXML2=ON
	cmake --build build -j"${JOBS:-4}"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

libs() {
	pkgdesc="LLVM shared libraries"
	depends=""
	amove usr/lib/libLLVM.so.*
	amove usr/lib/libclang-cpp.so.*
	amove usr/lib/libclang.so.*
	amove usr/lib/libLTO.so.*
	amove usr/lib/libRemarks.so.*
}

clang() {
	pkgdesc="C language family frontend for LLVM"
	depends="$pkgname-libs=$pkgver-r$pkgrel"
	amove usr/bin/clang
	amove usr/bin/clang++
	amove usr/bin/clang-cpp
	amove usr/bin/clang-cc1
	amove usr/lib/clang
	amove usr/include/clang
	amove usr/include/clang-c
	amove usr/lib/cmake/clang
}

clang_tools_extra() {
	pkgdesc="Extra clang tools (clang-format, clang-tidy, ...)"
	depends="clang=$pkgver-r$pkgrel"
	amove usr/bin/clang-format
	amove usr/bin/clang-tidy
	amove usr/bin/clang-apply-replacements
	amove usr/bin/clang-change-namespace
	amove usr/bin/clang-doc
	amove usr/bin/clang-include-fixer
	amove usr/bin/clang-move
	amove usr/bin/clang-offload-packager
	amove usr/bin/clang-query
	amove usr/bin/clang-reorder-fields
	amove usr/bin/clang-scan-deps
	amove usr/bin/clangd
	amove usr/bin/modularize
	amove usr/bin/pp-trace
	amove usr/bin/run-clang-tidy
}

