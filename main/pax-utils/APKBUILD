# Maintainer Damir Holovati
pkgname=pax-utils
pkgver=1.3.11
pkgrel=0
pkgdesc="ELF related utils for ELF 32/64 binaries"
url="https://wiki.gentoo.org/wiki/Hardened/PaX_Utilities"
arch="all"
license="GPL-2.0-only"
depends="scanelf"
makedepends="meson"
options="!check"
subpackages="$pkgname-doc scanelf:_scanelf"

source="https://distfiles.gentoo.org/pub/proj/toolchain/pax-utils/pax-utils-$pkgver.tar.xz"

build() {
	# use_seccomp=false: no seccomp, no prctl filters.
	# use_libcap=disabled: there is no libcap.
	# lddtree_implementation=none: lddtree.py needs py3-elftools and the sh version is not
	# needed to build packages. Only scanelf (used by abuild) matters here.
	# build_manpages=disabled: the release tarball ships the prebuilt manuals, xmlto is not needed.
	abuild-meson \
		-Dlddtree_implementation=none \
		-Duse_seccomp=false \
		-Duse_libcap=disabled \
		-Dbuild_manpages=disabled \
		-Dtests=false \
		-Duse_fuzzing=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

_scanelf() {
	depends=""
	pkgdesc="Scan ELF binaries for stuff"
	replaces="pax-utils"

	amove usr/bin/scanelf
}

