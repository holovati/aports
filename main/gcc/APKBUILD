# Maintainer Damir Holovati

pkgname=gcc
pkgver=15.2.0
pkgrel=0
pkgdesc="The GNU Compiler Collection"
url="https://gcc.gnu.org/"
arch="x86_64"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="binutils libc-dev"
makedepends="gmp mpfr mpc zlib zstd flex bison"

subpackages="$pkgname-doc"

depends="binutils gmp mpfr mpc zlib zstd"

source="
	gcc-$pkgver.tar.gz::https://mirrors.dotsrc.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.gz
	gcc-$pkgver.patch
	emerixx.h
	"

# Skip tests - they take too long and require special setup
options="!check"

builddir="$srcdir"/gcc-"$pkgver"

prepare() {
	default_prepare

	# Copy emerixx.h to the gcc config directory	
	cp "$srcdir"/emerixx.h "$builddir"/gcc/config/emerixx.h
}

objdir="$srcdir"/gcc-build

build() {
	# GCC requires out-of-tree build
	mkdir -p "$objdir"

	pushd "$objdir"

	CFLAGS="$CFLAGS -pipe" \
	CXXFLAGS="$CXXFLAGS -pipe -Wno-error -Wno-format-security" \
	"$builddir"/configure \
		--prefix=/usr \
		--build=$CBUILD \
		--host=$CHOST \
		--target=$CTARGET \
		--with-gmp=/usr \
		--with-mpfr=/usr \
		--with-mpc=/usr \
		--with-zlib=/usr \
		--with-zstd=/usr \
		--with-system-zlib \
		--with-default-cflags="-pipe" \
		--with-default-cxxflags="-pipe" \
		--with-as=/usr/bin/as \
		--with-gnu-as \
		--with-ld=/usr/bin/ld \
		--with-gnu-ld \
		--enable-languages=c,c++ \
		--enable-shared \
		--enable-threads=posix \
		--disable-nls \
		--disable-multilib \
		--disable-bootstrap \
		--disable-fixincludes \
		--disable-werror \
		--disable-default-pie \
		--disable-default-ssp \
		--libdir=/usr/lib \
		--libexecdir=/usr/libexec
		
		make
	popd
}

package() {
	cd "$objdir"
	
	make DESTDIR="$pkgdir" install

	ln -sf gcc "$pkgdir"/usr/bin/cc
	ln -sf g++ "$pkgdir"/usr/bin/c++
}

