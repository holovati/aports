ddf2db9ce22da39282d135bd2dc1ec953c2344a17cc738c3ab3c27eaa1fd3a0f0fc6b7a73b77cdcda318c09e5eabaf4b65e5e7a0c6409377e5bdb805a3dc77ac  gcc-15.2.0.patch
