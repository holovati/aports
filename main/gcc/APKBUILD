# Maintainer Damir Holovati

pkgname=gcc
pkgver=15.2.0
pkgrel=0
pkgdesc="The GNU Compiler Collection"
url="https://gcc.gnu.org/"
arch="x86_64"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="binutils libc-dev"
makedepends="gmp-dev mpfr-dev mpc-dev zlib-dev zstd-dev flex bison"

subpackages="$pkgname-doc"

depends="$binutils gmp mpfr mpc zlib zsdt"

source="
	gcc-$pkgver.tar.gz::https://mirrors.dotsrc.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.gz
	gcc-$pkgver.patch
	emerixx.h
	"
	
builddir="$srcdir/gcc-$pkgver"

# Skip tests - they take too long and require special setup
options="!check"

prepare() {
	default_prepare
    
	# Copy emerixx.h to the gcc config directory
	cp "$srcdir/emerixx.h" "$builddir/gcc/config/emerixx.h"
}

builddir="$srcdir"/gcc-build

build() {
	# GCC requires out-of-tree build
	mkdir -p "$builddir"

	pushd "$builddir"

	CFLAGS="$CFLAGS -pipe" \
	CXXFLAGS="$CXXFLAGS -pipe -Wno-error -Wno-format-security" \
	"$srcdir/gcc-$pkgver"/configure \
		--prefix=/usr \
		--build=$CBUILD \
		--host=$CHOST \
		--target=$CTARGET \
		--with-gmp=/usr \
		--with-mpfr=/usr \
		--with-mpc=/usr \
		--with-zlib=/usr \
		--with-zstd=/usr \
		--with-system-zlib \
		--with-default-cflags="-pipe" \
		--with-default-cxxflags="-pipe" \
		--with-as=/usr/bin/as \
		--with-gnu-as \
		--with-ld=/usr/bin/ld \
		--with-gnu-ld \
		--enable-languages=c,c++ \
		--enable-shared \
		--enable-threads=posix \
		--disable-nls \
		--disable-multilib \
		--disable-bootstrap \
		--disable-fixincludes \
		--disable-werror \
		--disable-default-pie \
		--disable-default-ssp \
		--libdir=/usr/lib \
		--libexecdir=/usr/libexec
		
		make
	popd
}

package() {
	make DESTDIR="$pkgdir" install
}

doc() {
      # Have no idea why this goes wrong and no time to debug it.
	default_doc || true
	amove usr/share/info || true
	amove usr/share/man || true
}

