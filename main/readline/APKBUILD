# Maintainer Damir Holovati

pkgname=readline
pkgver=8.3
pkgrel=0
pkgdesc="GNU readline library"
url="https://tiswww.cwru.edu/php/chet/readline/rltop.html"
arch="all"
options="!check"
license="GPL-3.0-or-later"

# Keep only doc split
subpackages="$pkgname-doc"

source="https://ftp.gnu.org/gnu/readline/readline-$pkgver.tar.gz
		fix-ncurses-underlinking.patch
		fix-shobj-conf-missing-emerixx.patch
		inputrc"

patch_args="-p0" # patchlevel used by upstream patches

_i=1
while [ $_i -le ${pkgver##*.} ]; do
	_patch=$(printf "%03d" $_i)
	_name=$pkgname${pkgver//./}-$_patch
	source="$source $_name.patch::https://ftp.gnu.org/gnu/readline/readline-$pkgver-patches/$_name"
	_i=$((_i+1))
done

builddir="$srcdir/$pkgname-$_myver"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-static \
		--enable-shared \
		--with-curses

	make
}

package() {
	make DESTDIR="$pkgdir" install
}

