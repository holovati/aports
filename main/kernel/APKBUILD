67113c64b6593e43aa77dfde6907ab4870cf6d4be0a7cc799233ca3300d18d506ed73ba2c4b020e75079daa3afd267ecd7e40207ef3ab7fe4947356f6e4c30ff  rs64-acpica-d7eadcdbd43dcfad33e997d50c7682ec30ecb911.tar.gz
d34771bf6526a47e6727c686a044579510c4004c7b85cac8a63961037a8b20cc007a4fcf1bb47ee1680b103af5c26ae2cfac733b2505866d82baa5b4ef44425c  lwip-d0efd9ef7ba08e54b46b1060e2b4629a4907391b.tar.gz
"
