# Maintainer Damir Holovati
pkgname=emerixx-utils
pkgver=1.0
pkgrel=0
pkgdesc="A stand-alone shell with many built-in commands"
url="https://gitlab.com/holovati/emerixx-utils"
arch="all"
license="MIT"

options="!check"

source="https://gitlab.com/holovati/emerixx-utils/-/archive/main/emerixx-utils-main.tar.gz"

builddir="$srcdir"/emerixx-utils-main

build() {
	unset CFLAGS
	unset LDFLAGS
	make
}

package() {
	make DESTDIR="$pkgdir" BINDIR=/usr/sbin install
}

