# Maintainer Damir Holovati
pkgname=xcb-util-wm
pkgver=0.4.2
pkgrel=0
pkgdesc="XCB ICCCM and EWMH helpers"
url="https://xcb.freedesktop.org/"
arch="all"
license="MIT"
depends_dev="libxcb"
makedepends="$depends_dev m4 util-macros"
source="https://xcb.freedesktop.org/dist/xcb-util-wm-$pkgver.tar.xz"

build() {
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
