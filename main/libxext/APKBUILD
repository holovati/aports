# Maintainer Damir Holovati
pkgname=libxext
pkgver=1.3.6
pkgrel=0
pkgdesc="X11 miscellaneous extensions library"
url="https://xorg.freedesktop.org/"
arch="all"
license="MIT"
# xmlto
makedepends="libxau libx11 xorgproto util-macros"
subpackages="$pkgname-doc"
options="!check"
source="https://www.x.org/releases/individual/lib/libXext-$pkgver.tar.xz
	"

builddir="$srcdir"/libXext-$pkgver

build() {
#		--with-xmlto \
#		--enable-static \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--without-fop
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
