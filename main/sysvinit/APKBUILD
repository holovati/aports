# Maintainer Damir Holovati
pkgname=sysvinit
pkgver=3.04
pkgrel=0
pkgdesc="Tradidional initialization system for Unix systems"
url="https://savannah.nongnu.org/projects/sysvinit"
arch="all"
license="GPL"
subpackages="$pkgname-doc"
options="!check"
makedepends="emerixx-utils"
source="https://download.savannah.nongnu.org/releases/sysvinit/sysvinit-$pkgver.tar.xz
	add-emerixx-defines.patch
	emerixx-console-fix.patch
	"

build() {
    make
}

package() {
	make ROOT="$pkgdir" install
	mv "$pkgdir"/bin/* "$pkgdir"/usr/bin
	rmdir "$pkgdir"/bin
	mv "$pkgdir"/sbin "$pkgdir"/usr/sbin

	# util-linux provides these
	rm "$pkgdir"/usr/bin/last
	rm "$pkgdir"/usr/bin/lastb
	rm "$pkgdir"/usr/bin/mesg
	rm "$pkgdir"/usr/bin/utmpdump
	rm "$pkgdir"/usr/bin/wall

	rm "$pkgdir"/usr/share/man/man1/last.1
	rm "$pkgdir"/usr/share/man/man1/lastb.1
	rm "$pkgdir"/usr/share/man/man1/mesg.1
	rm "$pkgdir"/usr/share/man/man1/utmpdump.1
	rm "$pkgdir"/usr/share/man/man1/wall.1
	
}


