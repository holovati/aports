# Maintainer Damir Holovati
pkgname=atk
pkgver=2.38.0
pkgrel=0
pkgdesc="Accessibility toolkit interfaces used by GTK"
url="https://gitlab.gnome.org/GNOME/atk"
arch="all"
license="LGPL-2.0-or-later"
depends="glib"
makedepends="glib meson pkgconf"
options="!check"
source="https://download.gnome.org/sources/atk/${pkgver%.*}/atk-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Dintrospection=false \
		-Ddocs=false \
		. output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
