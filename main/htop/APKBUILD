# Maintainer Damir Holovati

pkgname=htop
pkgver=3.5.3
pkgrel=1
pkgdesc="An interactive process viewer"
url="https://htop.dev"
arch="all"
license="GPL-2.0"
options="!check"

makedepends="
	autotools
	automake
	make
	"
depends="ncurses"

subpackages="$pkgname-doc"

source="htop-$pkgver.tar.gz::https://github.com/htop-dev/htop/archive/refs/tags/$pkgver.tar.gz
	LinuxProcessTable.c.patch
	LinuxMachine.c.patch"

prepare() {
    default_prepare
    sed -i 's/linux\*|gnu\*)/linux\*|gnu\*|emerixx\*)/g' configure.ac
    ./autogen.sh
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
