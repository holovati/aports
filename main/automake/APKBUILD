
# Maintainer Damir Holovati

pkgname=automake
pkgver=1.18.1
pkgrel=1
pkgdesc="GNU tool for automatically creating Makefiles"
url="https://www.gnu.org/software/automake"
arch="noarch"
license="GPL-2.0-or-later"
depends="perl"
makedepends="autoconf"
subpackages="$pkgname-doc"
source="https://ftp.gnu.org/gnu/automake/automake-$pkgver.tar.xz
	add-emerixx-config-sub.patch
	add-emerixx-config-guess.patch
	"

# many tests have bashisms
options="!check"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
		
	make ACLOCAL=: AUTOMAKE=:
}

check() {
	make check
}

package() {
	make ACLOCAL=: AUTOMAKE=: DESTDIR="$pkgdir" install
}

