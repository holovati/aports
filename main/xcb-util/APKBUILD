# Maintainer Damir Holovati
pkgname=xcb-util
pkgver=0.4.1
pkgrel=0
pkgdesc="Utility libraries for XCB (aux, atom, event)"
url="https://xcb.freedesktop.org/"
arch="all"
license="MIT"
depends_dev="libxcb"
makedepends="$depends_dev gperf m4 util-macros"
source="https://xcb.freedesktop.org/dist/xcb-util-$pkgver.tar.xz"

build() {
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--disable-static
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}

sha512sums="
