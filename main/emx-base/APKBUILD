# Maintainer Damir Holovati
pkgname=emx-base
pkgver=1.0
pkgrel=0
pkgdesc="Meta package for EMX base system"
url="https://www.github.com/holovati/emx"
arch="noarch"
license="MIT"

depends="emx-baselayout emx-devnodes apk-tools sash coreutils bash readline libhistory emerixx-utils inetutils ca-certificates nano"

package() {
    mkdir -p "$pkgdir"

	# /bin -> /usr/bin
    ln -sf /usr/bin bin

	# /lib -> /usr/lib
    ln -sf /usr/lib lib
	
    # /sbin -> /usr/sbin
    ln -sf /usr/sbin sbin
}