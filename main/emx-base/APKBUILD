# Maintainer Damir Holovati
pkgname=emx-base
pkgver=1.0
pkgrel=1
pkgdesc="Meta package for EMX base system"
url="https://www.github.com/holovati/emx"
arch="noarch"
license="MIT"
options="!check"

# What the system needs to boot, log in and manage packages. Anything the user may want to
# swap or remove (editors, pagers, network tools) belongs in the image profile instead.
depends="
	emx-baselayout sysvinit util-linux apk-tools sash coreutils bash readline
	emerixx-utils inetutils ca-certificates
	mingetty shadow
	findutils grep sed gawk gzip tar diffutils
	ncurses psmisc e2fsprogs
	"

package() {
    mkdir -p "$pkgdir"
}
