# Maintainer Damir Holovati
pkgname=vi
pkgver=9.2.1332
pkgrel=1
pkgdesc="Vi-style text editor, terminal only"
url="https://www.vim.org"
arch="all"
license="Vim"
depends="ncurses"
makedepends="ncurses"
# It ships the runtime files, xxd and vimtutor too, the same files the vim, vim-common and xxd
# packages have. Either side may overwrite the other, whichever is installed second.
replaces="vim vim-common xxd gvim"
subpackages="$pkgname-doc"
options="!check" # the test suite needs a pty and a lot of tooling
source="vim-$pkgver.tar.gz::https://github.com/vim/vim/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/vim-$pkgver"

build() {
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--with-features=normal \
		--enable-gui=no \
		--without-x \
		--enable-multibyte \
		--disable-nls \
		--disable-gpm \
		--disable-sysmouse \
		--disable-selinux \
		--disable-acl \
		--disable-canberra \
		--disable-netbeans \
		--disable-pythoninterp \
		--disable-python3interp \
		--disable-perlinterp \
		--disable-rubyinterp \
		--disable-luainterp \
		--disable-tclinterp \
		--disable-cscope \
		--disable-darwin \
		--disable-smack
	make
}

package() {
	make DESTDIR="$pkgdir" install

	# make install names the binary vim and links vi, ex and view to it. This
	# package only offers vi: the binary becomes vi, the vim names are left to
	# the vim package.
	cd "$pkgdir"/usr/bin
	rm -f vi ex view vimdiff rvim rview rvi
	mv vim vi
	ln -s vi ex
	ln -s vi view
}

doc() {
	replaces="vim-doc"
	default_doc
}

sha512sums="
6df4696af4fc07a78085b2cad4dc74b354733e610b6b66fccc549aceeb326991814464e748c849d18880a7e94253c4fe2c4420e4a5780e5d5b1fa3972ad02bb7  vim-9.2.1332.tar.gz
"
